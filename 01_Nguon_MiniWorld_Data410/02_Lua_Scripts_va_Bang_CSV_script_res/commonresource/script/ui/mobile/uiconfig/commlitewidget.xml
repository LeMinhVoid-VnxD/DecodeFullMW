<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	<Script file="ui/mobile/uiconfig/commlitewidget.lua" />
	##通用的一些小控件或模板

	##空白页面模板("暂无存档/暂无房间...")
	<Frame name="TempEmptyFrame" virtual="true" abs_x="250" abs_y="300">
        <Layers>
            <Layer level="BACKGROUND">
                <!-- <Texture name="$parentBkg" inherits="TemplateBkg25" /> -->
                <Texture name="$parentBkgRabbit" file="ui/mobile/texture2/bigtex/img_noreview.png" abs_x="244" abs_y="255">
                    <Anchors>
                        <Anchor point="center" relativePoint="center" relativeTo="$parent" />
                    </Anchors>
                </Texture>
                <FontString name="$parentTip"  fonttype="BlackFont24"  text="没有脚本打印信息" justifyH="center" abs_x="350" abs_y="24">
                    <Color r="77" g="112" b="117"/>
                    <Anchors>
                        <Anchor point="top" relativePoint="bottom" relativeTo="$parentBkgRabbit" >
                            <Offset>
                                <AbsDimension x="0" y="20"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>

    ##通用下拉框列表
    ##下拉列表条目模板
	<Button name="TemplateSearchDownListItem" inherits="TemplateDownListItem" virtual="true">
		<Scripts>
			<OnClick>GetInst("CommDropDownListCtrl"):ItemOnClick();</OnClick>
		</Scripts>
	</Button>

	##下拉列表通用页面
	<Frame name="CommonCombBoxListFrame" parent="UIClient" frameStrata="HIGH" hidden="true" framelevel="9000">
		<Frames>
			##条目模板"TemplateSearchDownListItem"
		</Frames>
		<Scripts>
			<OnClick>GetInst("CommDropDownListCtrl"):Close();</OnClick>
		</Scripts>
	</Frame>

</Ui>