	##卡通主窗口
	<Frame name="HolographicCartoon" parent="UIClient" frameStrata="MEDIUM" hidden="true" framelevel="1001">
		<Size>
			<RelDimension x="1.0" y="1.0"/>
		</Size> 
		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0" />
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBkg" file="ui/mobile/texture2/bigtex/bg_cartoon.png" stretchedge="true" framelevel="1002">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parentTitle" justifyH="left" justifyV="middle" fonttype="BlackFont30" abs_x="400" abs_y="30" text="$2129">
