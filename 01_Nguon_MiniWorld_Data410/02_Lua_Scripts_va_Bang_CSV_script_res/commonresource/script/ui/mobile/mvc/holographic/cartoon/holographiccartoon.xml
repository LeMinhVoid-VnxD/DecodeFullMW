							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parent">
									<Offset>
										<AbsDimension x="0" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</Texture>
						<Texture name="$parentFlag" file="ui/mobile/texture0/shop.xml" uvname="icon_close_ar.png" abs_x="32" abs_y="32">
