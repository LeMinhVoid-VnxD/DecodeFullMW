					<OnMouseOut>OnClickAnimation("OnMouseOut",{"HolographicCartoonCloseBtnNormal","HolographicCartoonCloseBtnFlag"});</OnMouseOut>
				</Scripts>
			</Frame>
			<Frame name="$parentCartoonRight" inherits="HolographicCartoonTemplate" abs_x="601" abs_y="352" id="3">
