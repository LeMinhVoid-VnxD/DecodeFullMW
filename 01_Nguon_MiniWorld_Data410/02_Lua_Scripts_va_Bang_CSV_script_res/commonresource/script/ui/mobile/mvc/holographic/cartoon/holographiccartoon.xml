						<Anchor point="center" relativePoint="center" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentTipMask" file="ui/white.png" color="80000000" abs_x="760" abs_y="40" hidden="true">
