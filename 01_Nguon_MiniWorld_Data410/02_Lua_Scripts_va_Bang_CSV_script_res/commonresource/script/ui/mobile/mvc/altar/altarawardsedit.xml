						<Anchor point="topleft" relativeTo="$parentChenDi" relativePoint="topleft">
							<Offset>
								<AbsDimension x="5" y="5" />
							</Offset>
						</Anchor>
					</Anchors>						
				</Texture>

				<Texture name="$parentMask1" inherits="TemplateBigBkg7_flat" abs_x="399" abs_y="67">
					<Anchors>
						<Anchor point="topleft" relativeTo="$parentChenDi" relativePoint="topleft">
							<Offset>
								<AbsDimension x="5" y="5" />
							</Offset>
