			## (标题名, 关闭按钮, 白底) 仿TemplateMainFrame2
			<Frame name="$parentFrame" inherits="AltarMainFrame1"  abs_x="413" abs_y="388">
				<Anchors>
					<Anchor point="center" relativeTo="$parent" relativePoint="center">
						<Offset>
							<AbsDimension x="0" y="0" />
						</Offset>
					</Anchor>
				</Anchors>			
			</Frame>



