						</Anchor>
					</Anchors>
				</FontString>									
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentCloseBtn" inherits="TemplateCloseBtn0" abs_x="36" abs_y="46">
				<Anchors>
					<Anchor point="topright" relativePoint="topright" relativeTo="$parentChenDi">
						<Offset>
							<AbsDimension x="-27" y="16"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("AltarAwardsEdit"):CloseBtnClicked();</OnClick>
				</Scripts>				
			</Button>
		</Frames>
