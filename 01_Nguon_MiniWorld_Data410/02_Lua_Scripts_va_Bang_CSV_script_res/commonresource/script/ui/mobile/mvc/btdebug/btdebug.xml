		<Size>
			<AbsDimension x="100" y="60"/>
		</Size> 
		<Layers>
			<Layer level="BACKGROUND">
				<!-- <Texture name="$parentBgMask" file="ui/white.png" color="80000000" stretchedge="true" framelevel="1002">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture> -->
				<FontString name="$parentNode" fonttype="BlackFont" text="BTNode_Temple" justifyH="topleft" justifyV="topleft" abs_x="200" abs_y="15">
					<Color r="55" g="54" b="251"/>
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
							<Offset>
								<AbsDimension x="5" y="5"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentParam" fonttype="BlackFont" text="" justifyH="topleft" justifyV="top" abs_x="200" abs_y="15">
					<Color r="55" g="54" b="251"/>
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
							<Offset>
								<AbsDimension x="5" y="20"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
