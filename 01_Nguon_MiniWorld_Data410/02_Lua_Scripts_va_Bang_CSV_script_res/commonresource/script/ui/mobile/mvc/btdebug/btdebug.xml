	<Frame name="BTDebug" parent="UIClient" frameStrata="MEDIUM" hidden="true" framelevel="1001">
		<Size>
			<AbsDimension x="500" y="600"/>
		</Size>
		<Anchors>
			<Anchor point="left" relativePoint="left" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0" />
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBgMask" file="ui/white.png" color="80000000" stretchedge="true" framelevel="1002">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentBg" inherits="BkgTemplate85" framelevel="1004">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
							<Offset>
								<AbsDimension x="55" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentCloseBtn" framelevel="1003">
				<Size>
					<AbsDimension x="53" y="53"/>
				</Size>
				<Anchors>
					<Anchor point="topright" relativeTo="$parentBg" relativePoint="topright">
						<Offset>
							<AbsDimension x="-55" y="5"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture name="$parentNormal" file="ui/mobile/texture2/common.xml" uvname="btn_close.png" />
				<PushedTexture name="$parentPushedBG" file="ui/mobile/texture2/common.xml" uvname="btn_close.png" >
					<Size>
						<AbsDimension x="50" y="50"/>
					</Size>
					<Anchors>
						<Anchor point="center" relativeTo="$parent" relativePoint="center">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</PushedTexture>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("BTDebug"):CloseBtnClicked();</OnClick>
				</Scripts>
			</Button>
			<TreeFrame name="$parentTree" framelevel="1003">
				<Size>
					<AbsDimension x="500" y="600"/>
				</Size>
				<Anchors>
					<Anchor point="topleft" relativeTo="$parent" relativePoint="topleft">
						<Offset>
							<AbsDimension x="0" y="60"/>
						</Offset>
					</Anchor>
				</Anchors>
			</TreeFrame>
		</Frames>
		<Scripts>
			<OnEvent>GetInst("UIManager"):GetCtrl("BTDebug"):HandleEvent();</OnEvent>
			<OnUpdate>GetInst("UIManager"):GetCtrl("BTDebug"):OnUpdate();</OnUpdate>
		</Scripts>
	</Frame>
