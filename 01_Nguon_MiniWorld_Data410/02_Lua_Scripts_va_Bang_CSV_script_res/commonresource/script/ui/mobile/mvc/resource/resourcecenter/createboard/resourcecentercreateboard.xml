	##资源格子模板
	<Frame name="ResourceCenterCreateBoardGridTemplate" inherits="ResourceGridTemplate" virtual="true" >
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentMask" inherits="TemplateBigBkg18" hidden="true" abs_x="74" abs_y="74">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parentBkg" />
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture name="$parentState" file="ui/mobile/texture2/common_icon.xml" uvname="icon_minicanvas_white" abs_x="22" abs_y="22" hidden="true" >
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBkg">
							<Offset>
								<AbsDimension x="4" y="4" />
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>GetInst("UIManager"):GetCtrl("ResourceCenterCreateBoard"):GridClicked();</OnClick>
		</Scripts>
	</Frame>

	##资源中心移动文件
	<Frame name="ResourceCenterCreateBoard" parent="UIClient" frameStrata="MEDIUM" hidden="true" framelevel="12" rel_x="1.0" rel_y="1.0" >
		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0" />
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBgMask" file="ui/white.png" color="80000000" stretchedge="true">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentBg" inherits="TemplateBigBkg2" abs_x="822" abs_y="501" >
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentMiddleBg" inherits="TemplateBigBkg5" abs_x="788" abs_y="291" >
