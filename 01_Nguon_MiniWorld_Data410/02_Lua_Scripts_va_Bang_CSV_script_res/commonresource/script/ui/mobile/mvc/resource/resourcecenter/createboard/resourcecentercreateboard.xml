					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parentMiddleBg">
							<Offset>
								<AbsDimension x="0" y="-36" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString> 
			</Layer>
		</Layers>
		<Frames>
			##标题栏
			<Frame name="$parentTitle" inherits="TemplateTopTitleBkg1" >
				<Anchors>
					<Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBg">
						<Offset>
							<AbsDimension x="2" y="0" />
						</Offset>
					</Anchor>
					<Anchor point="topright" relativePoint="topright" relativeTo="$parentBg">
						<Offset>
							<AbsDimension x="-2" y="0" />
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
			##关闭按钮
			<Button name="$parentCloseBtn" inherits="TemplateCloseBtn0" abs_x="46" abs_y="60">
				<Anchors>
					<Anchor point="topright" relativeTo="$parentBg" relativePoint="topright">
						<Offset>
							<AbsDimension x="-10" y="-8"/>
