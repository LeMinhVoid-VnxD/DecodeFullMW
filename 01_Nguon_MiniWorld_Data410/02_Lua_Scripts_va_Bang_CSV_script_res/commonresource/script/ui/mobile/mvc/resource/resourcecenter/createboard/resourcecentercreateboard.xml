						<Offset>
							<AbsDimension x="0" y="-19" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("ResourceCenterCreateBoard"):ConfirmBtnClicked();</OnClick>
				</Scripts>
			</Button>
		</Frames>
	</Frame>
</Ui>
