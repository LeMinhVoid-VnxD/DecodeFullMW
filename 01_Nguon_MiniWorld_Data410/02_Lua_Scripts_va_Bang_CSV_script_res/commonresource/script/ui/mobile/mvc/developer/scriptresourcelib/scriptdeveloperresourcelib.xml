	##左侧分类按钮模板
	<Button name="ScriptDeveloperResourceLib_TabBtnTemplate" inherits="TemplateTabBtn4" virtual="true">
		<Scripts>
			<onClick>GetInst("UIManager"):GetCtrl("ScriptDeveloperResourceLib"):TabBtnClicked(); </onClick>
		</Scripts>
	</Button>
	
	##item格子模板
	<Button name="ScriptDeveloperResourceLib_CellTemplate" virtual="true" abs_x="78" abs_y="78">
		<Layers>
			<Layer level="overlay">
				<Texture name="$parentBkg" inherits="TemplateBigBkg15" />
				<Texture name="$parentChecked" inherits="TemplateBigBkg13" hidden="true" />
				<Texture name="$parentIcon" file="item/apple.png" alphamode="alphablend" abs_x="70" abs_y="70">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>
				</Texture>
				##特效、音效库显示item序号，其他库不显示序号
				<FontString name="$parentIndex" hidden="true" fonttype="BlackFont18" fontStyle="border" text="1" justifyH="right" abs_x="70" abs_y="18">
					<Color r="255" g="255" b="255" />
					<Anchors>
						<Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
							<Offset>
								<AbsDimension x="-7" y="-7" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			##点击效果自动触发（PC上鼠标点击、手机上触屏）可使用platform指定触发平台
			<OnClick>GetInst("UIManager"):GetCtrl("ScriptDeveloperResourceLib"):CellBtnClicked();</OnClick>	
			##鼠标移入格子范围是自动触发
			<OnEnterUpdate>GetInst("UIManager"):GetCtrl("ScriptDeveloperResourceLib"):OnMouseEnter_PC();</OnEnterUpdate>
			<OnLeave platform="pc">GetInst("UIManager"):GetCtrl("ScriptDeveloperResourceLib"):OnMouseLeave_PC();</OnLeave>
		</Scripts>
	</Button>
	
