			<Anchor point="bottomleft" relativePoint="bottomleft" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0" />
				</Offset>
			</Anchor>
		</Anchors>
		<Frames>
			<Button name="$parentChangeItem" inherits="TemplateBtn20">
				<Anchors>
					<Anchor point="bottomleft" relativeTo="$parent" relativePoint="bottomleft" >
						<Offset>
							<AbsDimension x="200" y="-12"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="overlay">
						<FontString name="$parentTitle" fonttype="BlackFont24" justifyH="center" text="$4012" abs_x="182" abs_y="24">
							<Color r="55" g="52" b="51"/>
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parent" />
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("uiScriptEdit"):ChangeUIItem();</OnClick>
				</Scripts>
			</Button>
		</Frames>
	</Frame>


