						</Texture>
					</Layer>
				</Layers>
				<NormalTexture name="$parentNormal" file="ui/mobile/texture2/operate.xml" uvname="operating_board_square.png" />
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("ToolModeFrame"):RevertBtnClick();</OnClick>
				</Scripts>
			</Button>

            ##工具栏
			<Frame name="$parentToolFrame" abs_x="358" abs_y="88">
