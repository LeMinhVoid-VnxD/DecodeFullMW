				<Anchors>
					<Anchor point="bottom" relativePoint="bottom" relativeTo="$parent">
						<Offset>
							<AbsDimension x="0" y="-120" />
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="overlay" >
						<Texture name="$parentNormal" inherits="TemplateBkg82" />
						<Texture name="$parentChecked" inherits="TemplateBkg83" hidden="true" />
						<Texture name="$parentIcon" file="ui/mobile/texture2/operate.xml" uvname="icon_set.png" abs_x="29" abs_y="28">
							<Anchors>
								<Anchor point="left" relativePoint="left" relativeTo="$parent" >
									<Offset>
										<AbsDimension x="15" y="0" />
									</Offset>
								</Anchor>
							</Anchors>
						</Texture>
						<FontString name="$parentName" fonttype="BlackFont18" justifyH="center" text="进入工具模式" abs_x="150" abs_y="15">
							<Color r="255" g="255" b="255"/>
							<Anchors>
								<Anchor point="left" relativePoint="right" relativeTo="$parentIcon">
									<Offset>
										<AbsDimension x="0" y="0" />
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("ToolModeFrame"):ToolModeBtnClick();</OnClick>
				</Scripts>
			</Button>

			##回滚按钮
			<Button name="$parentRevertBtn" abs_x="88" abs_y="88" >
				<Anchors>
					<Anchor point="bottom" relativePoint="bottom" relativeTo="$parent">
						<Offset>
