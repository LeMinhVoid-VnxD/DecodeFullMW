					##3. 生物
					<Button name="$parentActor" inherits="ToolModeFrame_ToolBtnTemplate" id="3">
						<Anchors>
							<Anchor point="left" relativePoint="right" relativeTo="$parentPosition" />
						</Anchors>
					</Button>
					##3. 显示板
					<Button name="$parentDisplayBoard" inherits="ToolModeFrame_ToolBtnTemplate" id="4">
						<Anchors>
							<Anchor point="right" relativePoint="right" relativeTo="$parent" />
						</Anchors>
					</Button>
					##4. 对象库
					<Button name="$parentObjLib" abs_x="54" abs_y="54">
						<Anchors>
							<Anchor point="left" relativePoint="right" relativeTo="$parent" >
								<Offset>
									<AbsDimension x="20" y="0" />
