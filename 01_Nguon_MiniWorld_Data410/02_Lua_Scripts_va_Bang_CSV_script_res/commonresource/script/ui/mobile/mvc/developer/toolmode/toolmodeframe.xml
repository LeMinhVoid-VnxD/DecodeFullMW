					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="overlay" >
						<Texture name="$parentIcon" file="ui/mobile/texture2/ingame.xml" uvname="icon_return.png" abs_x="47" abs_y="47">
							<Anchors>
