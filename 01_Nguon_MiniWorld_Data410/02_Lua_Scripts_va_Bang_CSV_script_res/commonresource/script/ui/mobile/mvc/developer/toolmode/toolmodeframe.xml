								<FontString name="$parentIndex" fonttype="BlackFont18" justifyH="center" text="B" abs_x="50" abs_y="18">
									<Color r="254" g="248" b="220"/>
									<Anchors>
										<Anchor point="top" relativePoint="bottom" relativeTo="$parent" />
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
						<NormalTexture name="$parentNormal" file="ui/mobile/texture2/operate.xml" uvname="operating_board_square.png" />
						<Scripts>
							<OnMouseDown>GetInst("UIManager"):GetCtrl("ToolModeFrame"):ObjLibClick();</OnMouseDown>
						</Scripts>
					</Button>
				</Frames>
			</Frame>

			##生物选择
			<Button name="$parentActorSelect" abs_x="164" abs_y="38" >
				<Anchors>
					<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
						<Offset>
							<AbsDimension x="7" y="150" />
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="overlay" >
						<Texture name="$parentNormal" inherits="TemplateBkg82" />
						<Texture name="$parentCheckedBG" inherits="TemplateBkg83" hidden="true" />
