	##工具栏格子模板
	<Button name="ToolModeFrame_ToolBtnTemplate" abs_x="88" abs_y="88" virtual="true">
		<Layers>
			<Layer level="overlay" >
				<Texture name="$parentIcon" file="ui/mobile/texture2/ingame.xml" uvname="icon_area.png" abs_x="54" abs_y="54">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>
				</Texture>
				<Texture name="$parentChecked" inherits="TemplateBkg71" abs_x="74" abs_y="74" hidden="true">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>
				</Texture>
				<FontString name="$parentIndex" fonttype="BlackFont18" justifyH="center" text="1" abs_x="50" abs_y="18">
					<Color r="254" g="248" b="220"/>
					<Anchors>
						<Anchor point="top" relativePoint="bottom" relativeTo="$parent" />
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<NormalTexture name="$parentNormal" file="ui/mobile/texture2/operate.xml" uvname="operating_board_square.png" />
		<Scripts>
			<OnMouseDown>GetInst("UIManager"):GetCtrl("ToolModeFrame"):OnToolBtnClick();</OnMouseDown>
		</Scripts>
	</Button>
	
    ##工具模式窗口
	<Frame name="ToolModeFrame" parent="UIClient" frameStrata="BACKGROUND" framelevel="2"  hidden="true" input_transparent="true" >
		<Layers>
			<Layer level="BACKGROUND">
				
			</Layer>
		</Layers>
		<Frames>
			##实时坐标位置
			<Frame name="$parentPos" abs_x="164" abs_y="122">
				<Anchors>
					<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
						<Offset>
							<AbsDimension x="7" y="7" />
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="background" >
						<Texture name="$parentBkgOut" inherits="TemplateBkg68" />
						<Texture name="$parentBkg" inherits="TemplateBkg49" abs_x="160" abs_y="118">
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parent" />
							</Anchors>
						</Texture>
						<FontString name="$parentTitle" fonttype="BlackFont" justifyH="center" text="区域工具" abs_x="150" abs_y="16">
							<Color r="255" g="255" b="255"/>
							<Anchors>
								<Anchor point="top" relativePoint="top" relativeTo="$parent" >
									<Offset>
										<AbsDimension x="0" y="7" />
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
						##长
						<FontString name="$parentX" fonttype="BlackFont" justifyH="left" text="长: 1" abs_x="150" abs_y="16">
							<Color r="255" g="255" b="255"/>
							<Anchors>
								<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" >
									<Offset>
										<AbsDimension x="46" y="43" />
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
						##宽
						<FontString name="$parentZ" fonttype="BlackFont" justifyH="left" text="宽: 1" abs_x="150" abs_y="16">
							<Color r="255" g="255" b="255"/>
							<Anchors>
								<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" >
									<Offset>
										<AbsDimension x="46" y="69" />
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
						##高
						<FontString name="$parentY" fonttype="BlackFont" justifyH="left" text="高: 1" abs_x="150" abs_y="16">
							<Color r="255" g="255" b="255"/>
