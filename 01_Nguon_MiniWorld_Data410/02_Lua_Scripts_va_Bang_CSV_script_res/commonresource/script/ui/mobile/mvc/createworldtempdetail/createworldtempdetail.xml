            <Frame name="$parentMapName" abs_x="964" abs_y="62">
                <Anchors>
                    <Anchor point="top" relativePoint="top" relativeTo="$parent">
                        <Offset>
                            <AbsDimension x="0" y="32"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <FontString name="$parentName" fonttype="BlackFont20" text="$328" abs_x="120" abs_y="20">
                            <Color r="61" g="69" b="70"/>
                            <Anchors>
                                <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                                    <Offset>
                                        <AbsDimension x="0" y="14"/>
