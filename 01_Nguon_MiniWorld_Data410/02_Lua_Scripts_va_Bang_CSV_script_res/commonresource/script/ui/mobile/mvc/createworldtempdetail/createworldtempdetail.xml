                                </Anchor>
                            </Anchors>
                        </Texture>
                        ##分割线
                        <Texture name="$parentButtomLine" inherits="TemplateBkg20" abs_x="964" abs_y="2">
                            <Anchors>
                                <Anchor point="bottom" relativePoint="bottom" relativeTo="$parent" />
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Frames>
                    <SafeEditBox name="$parentEdit" letters="32" multiLine="false" abs_x="258" abs_y="20">
                        <Anchors>
                            <Anchor point="center" relativePoint="center" relativeTo="$parentNameEditBkg" />
                        </Anchors>
                        <FontString name="$parentFont" fonttype="BlackFont20"  justifyH="center">
                            <Color r="255" g="255" b="255"/>
                        </FontString>
                        <FontString name="$parentDefault" default="true" fonttype="BlackFont20" text="" textcolor="ffb9b9b9"/>
                        <Scripts>
                            <OnFocusLost>GetInst("UIManager"):GetCtrl("createWorldTempDetail"):MapNameOnFocusLost();</OnFocusLost>
                            <OnEnterPressed platform="pc">GetInst("UIManager"):GetCtrl("createWorldTempDetail"):MapNameOnEnterPressed();</OnEnterPressed>
                            <OnClick>GetInst("UIManager"):GetCtrl("createWorldTempDetail"):MapNameOnEnterPressed();</OnClick>
                        </Scripts>
                    </SafeEditBox>
                </Frames>
            </Frame>
