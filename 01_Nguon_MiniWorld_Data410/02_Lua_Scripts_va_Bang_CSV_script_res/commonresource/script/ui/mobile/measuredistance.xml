<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	<Script file="ui/mobile/measuredistance.lua" />
	##距离描述文字模板
	<Frame name="MeasureDistanceDescTemplate" abs_x="50" abs_y="50" virtual="true">
        <Layers>
            <Layer level="overlay">
            </Layer>
        </Layers>
        <Frames>
        	<RichText name="$parentDesc" lineInterval="15" multiLine="false" fonttype="BlackFont24" fontStyle="border" abs_x="380" abs_y="24">
				<Anchors>
					<Anchor point="center" relativePoint="center" relativeTo="$parent">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
			</RichText>
        </Frames>
    </Frame>

	##测量距离展示界面
	<Frame name="MeasureDistanceFrame" parent="UIClient" frameStrata="MEDIUM" hidden="true" framelevel="10" input_transparent="true" abs_x="1200" abs_y="100">
		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent" />
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<!-- <Texture name="$parentMask" file="ui/white.png" color="5d000000" /> -->
				<FontString name="$parentDesc" lineInterval="60" multiLine="false" fonttype="BlackFont24" justifyH="center" fontStyle="border" abs_x="1200" abs_y="24">
					<Anchors>
						<Anchor point="top" relativePoint="top" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>	
		<Scripts>
			<OnLoad>MeasureDistanceFrame_OnLoad();</OnLoad>
			<OnEvent>MeasureDistanceFrame_OnEvent();</OnEvent>
			<OnUpdate>MeasureDistanceFrame_OnUpdate();</OnUpdate>
			<OnShow>MeasureDistanceFrame_OnShow();</OnShow>
			<OnHide>MeasureDistanceFrame_OnHide();</OnHide>
		</Scripts>
	</Frame>
</Ui>