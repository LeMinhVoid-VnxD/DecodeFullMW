<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	##家园等级界面
	<Script file="ui/mobile/mvc/homeland/homelevel/HomeLevelCtrl.lua"/>
	<Script file="ui/mobile/mvc/homeland/homelevel/HomeLevelModel.lua"/>
	<Script file="ui/mobile/mvc/homeland/homelevel/HomeLevelView.lua"/>
	
	<!-- 家园等级详情展示面板 -->
	<Frame name="HomeLevel" parent="UIClient" frameStrata="MEDIUM" inherits="CommonPopPanel" hidden="true" framelevel="2000">
		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent" />
		</Anchors>
		<Frames>	
			<Frame name="$parentPanel" abs_x="653" abs_y="402">
				<Anchors>
					<Anchor point="center" relativePoint="center" relativeTo="$parent" />
				</Anchors>
				<Layers>
					<Layer level="overlay">
						<Texture name="$parentArrow" file="ui/mobile/texture2/modlib.xml" uvname="icon_pull_green" abs_x="15" abs_y="26">
							<Anchors>
								<Anchor point="top" relativePoint="top" relativeTo="$parent">
									<Offset>
										<AbsDimension x="0" y="183"/>
									</Offset>
								</Anchor>
							</Anchors>
						</Texture>
						<FontString name="$parentCurLevel" justifyH="right" justifyV="middle" fonttype="BlackFont26" abs_x="200" abs_y="26">
							<Color r="61" g="69" b="70" />
							<Anchors>
								<Anchor point="topright" relativePoint="top" relativeTo="$parent">
									<Offset>
										<AbsDimension x="-33" y="186"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
						<FontString name="$parentNextLevel" justifyH="left" justifyV="middle" fonttype="BlackFont26" abs_x="200" abs_y="26">
							<Color r="10" g="170" b="26" />
							<Anchors>
								<Anchor point="topleft" relativePoint="top" relativeTo="$parent">
									<Offset>
										<AbsDimension x="33" y="186"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
						<FontString name="$parentTips" justifyH="right" justifyV="middle" text="$41108" fonttype="BlackFont24" abs_x="200" abs_y="24" hidden="true">
							<Color r="61" g="69" b="70" />
							<Anchors>
								<Anchor point="topright" relativePoint="top" relativeTo="$parent">
									<Offset>
										<AbsDimension x="-33" y="158"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>	
					##关闭按钮
					<Button name="$parentCloseBtn" inherits="TemplateCloseBtn0" abs_x="46" abs_y="60">
						<Anchors>
							<Anchor point="topright" relativePoint="topright" relativeTo="$parent">
								<Offset>
									<AbsDimension x="-17" y="6" />
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnClick>GetInst("UIManager"):GetCtrl("HomeLevel"):CloseBtn_OnClick()</OnClick>
						</Scripts>
					</Button>
					## 升级奖励内容展示					
					<RichText name="$parentRewardText" fonttype="BlackFont24" lineInterval="2" abs_x="200" abs_y="160" autowrap="true">
						<Anchors>
							<Anchor point="topleft" relativePoint="top" relativeTo="$parent">
								<Offset>
									<AbsDimension x="33" y="158"/>
								</Offset>
							</Anchor>
						</Anchors>
					</RichText>	
					##炫耀一下
					<Button name="$parentShareHomeLevelBtn" inherits="TemplateBtn2">
						<Anchors>
							<Anchor point="bottom" relativePoint="bottom" relativeTo="$parent">
								<Offset>
									<AbsDimension x="-163" y="-26" />
								</Offset>
							</Anchor>
						</Anchors>
						<Layers>
							<Layer level="overlay">
								<FontString name="$parentText" justifyH="center" justifyV="middle" text="$5236" fonttype="BlackFont24" abs_x="100" abs_y="24">
									<Color r="51" g="55" b="55" />
									<Anchors>
										<Anchor point="center" relativePoint="center" relativeTo="$parent" />
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
						<Scripts>
							<OnClick>GetInst("UIManager"):GetCtrl("HomeLevel"):ShareBtn_OnClick()</OnClick>
						</Scripts>
					</Button>
					##确定按钮
					<Button name="$parentSureBtn" inherits="TemplateBtn3">
						<Anchors>
							<Anchor point="bottom" relativePoint="bottom" relativeTo="$parent">
								<Offset>
									<AbsDimension x="163" y="-26" />
								</Offset>
							</Anchor>
						</Anchors>
						<Layers>
							<Layer level="overlay">
								<FontString name="$parentText" justifyH="center" justifyV="middle" text="$3694" fonttype="BlackFont24" abs_x="100" abs_y="24">
									<Color r="55" g="54" b="51" />
									<Anchors>
										<Anchor point="center" relativePoint="center" relativeTo="$parent" />
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
						<Scripts>
							<OnClick>GetInst("UIManager"):GetCtrl("HomeLevel"):CloseBtn_OnClick()</OnClick>
						</Scripts>
					</Button>
				</Frames>
			</Frame>
		</Frames>		
	</Frame>
</Ui>
