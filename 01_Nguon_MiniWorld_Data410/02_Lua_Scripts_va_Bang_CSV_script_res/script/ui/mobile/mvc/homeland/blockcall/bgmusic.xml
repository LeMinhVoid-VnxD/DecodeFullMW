<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	<Script file="ui/mobile/mvc/homeland/blockcall/BGMusicModel.lua"/>
	<Script file="ui/mobile/mvc/homeland/blockcall/BGMusicView.lua"/>
	<Script file="ui/mobile/mvc/homeland/blockcall/BGMusicCtrl.lua"/>

	<!-- 背景音乐选项 -->
	<Button name="BGOptionMusicTemplate" virtual="true">
		<Size>
			<AbsDimension x="533" y="50"/>
		</Size>
		<Layers>
			<Layer level="background">
				<Texture name="$parentBkg" inherits="TemplateBkg33" />
				<Texture name="$parentCheck" inherits="TemplateBkg33" />
				<FontString name="$parentDesc" justifyH="center" fonttype="BlackFont24" text="$707">
					<Color r="55" g="54" b="41"/>
					<Size>
						<AbsDimension x="240" y="18"/>
					</Size>
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>GetInst("UIManager"):GetCtrl("BGMusic"):OptionMusicClicked();</OnClick>
		</Scripts>
	</Button>

	<!-- 背景音乐选择(或推荐) -->
	<Frame name="BGMusic" parent="UIClient" frameStrata="MEDIUM" framelevel="10">
		<Size>
			<RelDimension x="1.0" y="1.0" />
		</Size>
		<Layers>
			<Layer level="background">
				<Texture name="$parentBkg" file="ui/white.png" stretchedge="true" color="B1000000" />
				<Texture name="$parentChenDi1" inherits="TemplateBkg1">
					<Size>
						<AbsDimension x="653" y="484"/>
					</Size>
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>
				</Texture>
				<Texture name="$parentChenDi2" inherits="TemplateBigBkg5" >
					<Size>
						<AbsDimension x="562" y="300"/>
					</Size>
					<Anchors>
						<Anchor point="top" relativePoint="top" relativeTo="$parentChenDi1">
							<Offset>
								<AbsDimension x="0" y="155"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
                <FontString name="$parentDesc" fonttype="BlackFont20" text="$41563" justifyH="center" justifyV="middle" abs_x="562" abs_y="90">
                    <Color r="101" g="116" b="118"/>
                    <Anchors>
                        <Anchor point="top" relativePoint="top" relativeTo="$parentChenDi1">
                            <Offset>
                                <AbsDimension x="0" y="65"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
			</Layer>
		</Layers>
		<Frames>
			##标题栏
			<Frame name="$parentTitleFrame" inherits="TemplateTopTitleBkgWithHuaWen01" abs_x="638" abs_y="65">
				<Anchors>
					<Anchor point="top" relativeTo="$parentChenDi1" relativePoint="top" >
						<Offset>
							<AbsDimension x="-2.5" y="6"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
			##关闭按钮
			<Button name="$parentCloseBtn" inherits="TemplateCloseBtn0">
				<Anchors>
					<Anchor point="topright" relativeTo="$parentChenDi1" relativePoint="topright">
						<Offset>
							<AbsDimension x="-20" y="11"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("BGMusic"):CloseBtnClicked();</OnClick>
				</Scripts>
			</Button>
			<SlidingFrame name="$parentBox" slidingY="true" slideplane="$parentPlane">
				<Size>
					<AbsDimension x="562" y="272"/>
				</Size>
				<Anchors>
					<Anchor point="center" relativePoint="center" relativeTo="$parentChenDi2">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Frames>
					<Frame name="$parentPlane" hidden="true">
						<Size>
							<AbsDimension x="562" y="600"/>
						</Size>
					</Frame>
					<Frame name="$parent1" id="1" inherits="BGOptionMusicTemplate"/>
					<Frame name="$parent2" id="2" inherits="BGOptionMusicTemplate"/>
					<Frame name="$parent3" id="3" inherits="BGOptionMusicTemplate"/>
					<Frame name="$parent4" id="4" inherits="BGOptionMusicTemplate"/>
					<Frame name="$parent5" id="5" inherits="BGOptionMusicTemplate"/>
					<Frame name="$parent6" id="6" inherits="BGOptionMusicTemplate"/>
					<Frame name="$parent7" id="7" inherits="BGOptionMusicTemplate"/>
					<Frame name="$parent8" id="8" inherits="BGOptionMusicTemplate"/>
					<Frame name="$parent9" id="9" inherits="BGOptionMusicTemplate"/>
					<Frame name="$parent10" id="10" inherits="BGOptionMusicTemplate"/>
				</Frames>
			</SlidingFrame>
		</Frames>
	</Frame>
</Ui>