					<Anchors>
						<Anchor point="left" relativePoint="left" relativeTo="$parentWarningTips">
							<Offset>
								<AbsDimension x="0" y="30"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<ProgressBar name="$parentProgressBar" barname="$parentProgressTex" orientation="HORIZONTAL" hidden="false">
				<Size>
					<AbsDimension x="1280" y="3"/>
				</Size>
				<Anchors>
					<Anchor point="left" relativeTo="$parentProgressBarBkg" relativePoint="left">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture name="$parentProgressTex" file="ui/mobile/texture2/outgame2/uitex2.xml" uvname="jzjm_jindutiao02.png" DrawType="center" >
