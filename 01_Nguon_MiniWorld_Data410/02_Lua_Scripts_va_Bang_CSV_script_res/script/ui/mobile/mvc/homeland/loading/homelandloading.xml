							</Size>
							<Anchors>
								<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
									<Offset>
										<AbsDimension x="0" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</Texture>
					</Layer>
				</Layers>
			</ProgressBar>
		</Frames>
		<Scripts>
			<OnUpdate>GetInst("UIManager"):GetCtrl("HomeLandLoading"):Update();</OnUpdate>
		</Scripts>
	</Frame>
</Ui>
