						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parentTips" justifyH="center" justifyV="MIDDLE" fonttype="BlackFont30"  lineInterval="2" text="">
