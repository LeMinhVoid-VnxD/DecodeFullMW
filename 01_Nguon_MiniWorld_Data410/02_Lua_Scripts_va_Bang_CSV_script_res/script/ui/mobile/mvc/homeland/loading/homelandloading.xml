					<Anchors>
						<Anchor point="topright" relativePoint="topright" relativeTo="$parent">
							<Offset>
								<AbsDimension x="-20" y="13"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
                <FontString name="$parentWarningTipsDown" justifyH="right" justifyV="MIDDLE" fonttype="BlackFont24"  lineInterval="2" text="$21056" rel_x="1" abs_y="26">
