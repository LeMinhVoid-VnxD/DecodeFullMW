					<Size>
						<AbsDimension x="1250" y="70"/>
					</Size>
					<Anchors>
						<Anchor point="bottom" relativePoint="bottom" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<Texture name="$parentProgressBarBkg" file="ui/mobile/texture2/outgame2/uitex2.xml" uvname="jzjm_jindutiao01.png" DrawType="center" >
					<Size>
						<AbsDimension x="1280" y="3"/>
					</Size>
					<Anchors>
						<Anchor point="bottom" relativeTo="$parent" relativePoint="bottom">
							<Offset>
								<AbsDimension x="0" y="-10"/>
							</Offset>
						</Anchor>
					</Anchors>
					<Center>
						<Left			offsetX="0"  offsetY="0" w="10"	h="3"/>
						<Center			offsetX="10" offsetY="0" w="10"	h="3"	/>
						<Right			offsetX="20" offsetY="0" w="10" h="3" />
					</Center>
				</Texture>
				<FontString name="$parentWarningTips" justifyH="right" justifyV="MIDDLE" fonttype="BlackFont24"  lineInterval="2" text="$21051" rel_x="1" abs_y="26">
