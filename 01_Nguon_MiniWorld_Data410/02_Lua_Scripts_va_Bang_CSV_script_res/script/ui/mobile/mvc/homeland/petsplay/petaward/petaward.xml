		<Size>
			<RelDimension x="1.0" y="1.0"/>
		</Size>
		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<!-- 背景遮罩 -->
				<Texture name="$parentMask" file="ui/white.png" color="80000000" stretchedge="true"/>
				<!-- 背景图 -->
				<Texture name="$parentBkg" inherits="TemplateBigBkg8" abs_x="982" abs_y="584">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parentMask">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentBkg1" inherits="TemplateBigBkg2" abs_x="980" abs_y="450">
					<Anchors>
						<Anchor point="top" relativePoint="top" relativeTo="$parentBkg">
							<Offset>
								<AbsDimension x="0" y="56"/>
