			<!-- 确定按钮 -->
			<Button name="$parentConfirmBtn" inherits="TemplateBtn3" abs_x="182" abs_y="61">
				<Anchors>
					<Anchor point="bottom" relativeTo="$parentBkg" relativePoint="bottom">
						<Offset>
							<AbsDimension x="0" y="-15"/>
