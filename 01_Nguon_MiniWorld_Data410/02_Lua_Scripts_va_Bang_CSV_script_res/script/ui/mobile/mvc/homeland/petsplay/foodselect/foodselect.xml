		<Size>
			<RelDimension x="1.0" y="1.0"/>
		</Size>
		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<!-- 背景遮罩 -->
				<Texture name="$parentMask" file="ui/white.png" color="80000000" stretchedge="true"/>
				<!-- 背景图 -->
				<Texture name="$parentBkg" inherits="TemplateBigBkg2" abs_x="593" abs_y="616">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parentMask">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentBkg1" inherits="TemplateBigBkg5" abs_x="553" abs_y="434">
					<Anchors>
						<Anchor point="top" relativePoint="top" relativeTo="$parentBkg">
							<Offset>
								<AbsDimension x="0" y="75"/>
							</Offset>
						</Anchor>
