							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parentEmptyTip" fonttype="BlackFont24" justifyH="center" text="$41647" abs_x="553" abs_y="24" hidden="true">
					<Color r="77" g="112" b="117"/>
					<Anchors>
						<Anchor point="top" relativePoint="bottom" relativeTo="$parentEmptyIcon">
							<Offset>
								<AbsDimension x="0" y="22"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<!-- 描述 -->
				<FontString name="$parentTip" fonttype="BlackFont18" justifyH="center" text="宠物负重：10/100" abs_x="553" abs_y="18">
					<Color r="101" g="116" b="118"/>
					<Anchors>
						<Anchor point="bottom" relativePoint="bottom" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="-135"/>
							</Offset>
						</Anchor>
