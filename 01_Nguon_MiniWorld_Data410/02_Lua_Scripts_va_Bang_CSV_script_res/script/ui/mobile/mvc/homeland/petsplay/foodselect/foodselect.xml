						</Anchor>
					</Anchors>
				</Texture>						
			</Layer>
		</Layers>
		<Frames>
			<!-- 描述 -->
			<RichText name="$parentFoodDesc" fonttype="BlackFont18" lineInterval="2" multiLine="false" abs_x="233" abs_y="42" input_transparent="true">
