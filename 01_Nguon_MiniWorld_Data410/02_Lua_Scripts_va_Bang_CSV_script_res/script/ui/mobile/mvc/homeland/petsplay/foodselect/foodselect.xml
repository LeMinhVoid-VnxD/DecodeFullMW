				<PushedTexture name="$parentPushedBG" file="ui/mobile/texture2/modlib.xml" uvname="icon_pull_green.png" abs_x="13" abs_y="24">
					<Anchors>
						<Anchor point="left" relativePoint="left"/>
					</Anchors>
				</PushedTexture>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("FoodSelect"):AddBtnClicked()</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnClick>GetInst("UIManager"):GetCtrl("FoodSelect"):PetItemClick()</OnClick>
		</Scripts>
