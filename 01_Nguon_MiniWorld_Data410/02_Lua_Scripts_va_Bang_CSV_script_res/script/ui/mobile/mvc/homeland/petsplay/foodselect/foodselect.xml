					<Anchors>
						<Anchor point="right" relativePoint="right" relativeTo="$parent" />
					</Anchors>
				</PushedTexture>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("FoodSelect"):SubtractBtnClicked()</OnClick>
				</Scripts>
			</Button>
			<!-- 加号按钮 -->
			<Button name="$parentAddBtn" abs_x="25" abs_y="36" hidden="true">
				<Anchors>
