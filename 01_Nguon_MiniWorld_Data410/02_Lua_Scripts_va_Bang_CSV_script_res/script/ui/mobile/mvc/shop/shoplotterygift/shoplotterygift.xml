				</Texture>
				<FontString name="$parentNum" fonttype="BlackFont18" justifyH="right" justifyV="middle" abs_x="80"  abs_y="18" text="" fontStyle="border" shadowcolor="FF00274C">
					<Color r="255" g="255" b="255"/>
					<Anchors>
						<Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parentBkg">
							<Offset>
								<AbsDimension x="-5" y="-4"/>
