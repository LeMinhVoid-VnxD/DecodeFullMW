						<Anchor point="top" relativePoint="top" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentIcon" abs_x="70" abs_y="70">
