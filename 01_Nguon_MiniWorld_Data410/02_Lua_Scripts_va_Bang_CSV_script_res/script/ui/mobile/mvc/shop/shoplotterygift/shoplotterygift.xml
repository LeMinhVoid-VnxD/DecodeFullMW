						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
							<Offset>
								<AbsDimension x="-4" y="-6"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parentFlagText" fonttype="BlackFont18" justifyH="center" justifyV="middle" hiden="true" abs_x="71" abs_y="19">
					<Color r="255" g="255" b="255"/>
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parentFlagBkg">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentName" fonttype="BlackFont18" justifyH="center" justifyV="middle" abs_x="105"  abs_y="18" text="">
