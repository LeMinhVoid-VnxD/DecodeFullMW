							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</ModelView>	
			</Layer>
		</Layers>
		<Scripts>
			<OnEnter platform="pc">GetInst("UIManager"):GetCtrl("ShopLotteryGift"):OnMouseEnter_PCShow()</OnEnter>
			<OnLeave platform="pc">GetInst("UIManager"):GetCtrl("ShopLotteryGift"):OnMouseLeave_PCShow()</OnLeave>
			<OnClick platform="mobile">GetInst("UIManager"):GetCtrl("ShopLotteryGift"):ShowMobile_OnClick()</OnClick>
		</Scripts>
