<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
    <Script file="ui/mobile/mvc/shop/shopRechargeGuide/ShopRechargeGuideModel.lua"/>
	<Script file="ui/mobile/mvc/shop/shopRechargeGuide/ShopRechargeGuideView.lua"/>
	<Script file="ui/mobile/mvc/shop/shopRechargeGuide/ShopRechargeGuideCtrl.lua"/>

    <Frame name="ShopRechargeGuide" parent="UIClient" frameStrata="MEDIUM" hidden="true" framelevel="1800">
		<Size>
			<RelDimension x="1.0" y="1.0"/>
		</Size>
		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent"/>
		</Anchors>
        ##背景图
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentMask" file="ui/white.png" color="80000000" stretchedge="true"/>
				<Texture name="$parentBkg" inherits="TemplateBigBkg2">
                    <Size>
                        <AbsDimension x="1038" y="606"/>
                    </Size>
                    <Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parentMask">
							<Offset>
								<AbsDimension x="0" y="30"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
            ##专属档位充值
            <Frame name="$parentSp" abs_x = "980" abs_y = "210" hidden="false">
                <Anchors>
                    <Anchor point="top" relativePoint="top" relativeTo="$parentBkg">
                        <Offset>
                            <AbsDimension x="0" y="27"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Layers>
					<Layer>
                        <Texture name="$parentBoard" inherits="TemplateBigBkg5" abs_x = "980" abs_y = "210">
                            <Anchors>
                                <Anchor point="center" relativePoint="center" relativeTo="$parent">
                                    <Offset>
                                        <AbsDimension x="0" y="0"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </Texture>
                        <FontString name="$parentTips" fonttype="BlackFont26" justifyV="MIDDLE" text="您本月最多还可充值28元，可选择专属档位进行充值">
							<Color r="61" g="69" b="70"/>
							<Size>
								<AbsDimension x="650" y="26"/>
							</Size>
							<Anchors>
								<Anchor point="top" relativePoint="top" relativeTo="$parentBoard">
									<Offset>
										<AbsDimension x="0" y="17"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
                    </Layer>
				</Layers>
                <Frames>
                    <Button name="$parentRechargeBtn" inherits="ShopRechargeBoxTemplate">
                        <Anchors>
                            <Anchor point="bottom" relativePoint="bottom" relativeTo="$parent">
                                <Offset>
                                    <AbsDimension x="0" y="-18"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnClick>GetInst("UIManager"):GetCtrl("ShopRechargeGuide"):ShopRechargeGuideSpRecharge();</OnClick>
                        </Scripts>
                    </Button>
                </Frames>
            </Frame>
            ##正常充值档位
            <Frame name="$parentNor" abs_x = "980" abs_y = "350" hidden="false">
                <Anchors>
                    <Anchor point="top" relativePoint="bottom" relativeTo="$parentSp">
                        <Offset>
                            <AbsDimension x="0" y="10"/>
                        </Offset>
                    </Anchor>
                    <Anchor point="bottom" relativePoint="bottom" relativeTo="$parentBkg">
                        <Offset>
                            <AbsDimension x="0" y="-10"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Layers>
					<Layer level="overlay">
                        <FontString name="$parentTips" fonttype="BlackFont26" justifyV="MIDDLE" justifyH="center" text="或选择以下档位进行充值">
                            <Color r="61" g="69" b="70"/>
                            <Size>
                                <AbsDimension x="650" y="26"/>
                            </Size>
                            <Anchors>
                                <Anchor point="top" relativePoint="top" relativeTo="$parent">
                                    <Offset>
                                        <AbsDimension x="0" y="15"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <SlidingFrame name="$parentRechargeBox" slidingY="true" slideplane="$parentPlane">
                        <Anchors>
                            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                                <Offset>
                                    <AbsDimension x="0" y="50"/>
                                </Offset>
                            </Anchor>
                            <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
                                <Offset>
                                    <AbsDimension x="0" y="0"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <Frames>
                            <Frame name="$parentPlane" hidden="true">
                                <Size>
                                    <AbsDimension x="980" y="290"/>
                                </Size>
                                <Anchors>
                                    <Anchor point="top" relativePoint="top" relativeTo="$parent">
                                        <Offset>
                                            <AbsDimension x="0" y="0"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                            </Frame>
                            <Button name="$parentItem1" inherits="ShopRechargeBoxTemplate" id="1" />
                            <Button name="$parentItem2" inherits="ShopRechargeBoxTemplate" id="2" />
                            <Button name="$parentItem3" inherits="ShopRechargeBoxTemplate" id="3" />
                            <Button name="$parentItem4" inherits="ShopRechargeBoxTemplate" id="4" />
                            <Button name="$parentItem5" inherits="ShopRechargeBoxTemplate" id="5" />
                            <Button name="$parentItem6" inherits="ShopRechargeBoxTemplate" id="6" />
                            <Button name="$parentItem7" inherits="ShopRechargeBoxTemplate" id="7" />
                            <Button name="$parentItem8" inherits="ShopRechargeBoxTemplate" id="8" />
                            <Button name="$parentItem9" inherits="ShopRechargeBoxTemplate" id="9" />
                            <Button name="$parentItem10" inherits="ShopRechargeBoxTemplate" id="10" />
                        </Frames>
                    </SlidingFrame>
                </Frames>
            </Frame>
            ##顶部标题栏
			<Frame name="$parentHead" inherits="TemplateTopTitleBkg0">
				<Size>
					<AbsDimension x="1032" y="61"/>
				</Size>
				<Anchors>
					<Anchor point="bottom" relativeTo="$parentBkg" relativePoint="top">
						<Offset>
							<AbsDimension x="0" y="8"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer>
						<FontString name="$parentTitle" fonttype="BlackFont36" justifyV="MIDDLE" text="$30303" shadowcolor="4D352C28">
							<Color r="255" g="135" b="27"/>
							<Size>
								<AbsDimension x="512" y="38"/>
							</Size>
							<Anchors>
								<Anchor point="left" relativePoint="left" relativeTo="$parent">
									<Offset>
										<AbsDimension x="33" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
                <Frames>
                    <RichText name="$parentLimit" fonttype="BlackFont20" justifyH="left" abs_x="220" abs_y="20" multiLine="true">
                        <Anchors>
                            <Anchor point="right" relativePoint="right" relativeTo="$parent" >
                                <Offset>
                                    <AbsDimension x="-114" y="0"/>
                                </Offset>
                            </Anchor>
                        </Anchors>    
                    </RichText>
                </Frames>
			</Frame>
			<Button name="$parentCloseBtn" inherits="TemplateCloseBtn0">
				<Size>
					<AbsDimension x="46" y="60"/>
				</Size>
				<Anchors>
					<Anchor point="topright" relativeTo="$parentHead" relativePoint="topright">
						<Offset>
							<AbsDimension x="-10" y="-8"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("ShopRechargeGuide"):CloseBtnClicked();</OnClick>
				</Scripts>
			</Button>

		</Frames>		
		<Scripts>
			<OnEvent>GetInst("UIManager"):GetCtrl("ShopRechargeGuide"):HandleEvent();</OnEvent>
		</Scripts>
	</Frame>

</Ui>