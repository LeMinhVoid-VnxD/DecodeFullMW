<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	<Script file="ui/mobile/mvc/pcAdvertisement/PcAdvertisementModel.lua"/>
	<Script file="ui/mobile/mvc/pcAdvertisement/PcAdvertisementView.lua"/>
	<Script file="ui/mobile/mvc/pcAdvertisement/PcAdvertisementCtrl.lua"/>

	<Frame name="PcAdvertisement" parent="UIClient" frameStrata="HIGH" hidden="true" framelevel="9999">
		<Size>
			<RelDimension x="1.0" y="1.0"/>
		</Size> 
		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0" />
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
		</Layers>
		<Frames>
			<Frame name="$parentBg">
				<Layer level="BACKGROUND">
					<Texture name="$parentBgMask" file="ui/white.png" color="80000000" stretchedge="true">
						<Anchors>
							<Anchor point="center" relativePoint="center" relativeTo="$parent">
								<Offset>
									<AbsDimension x="0" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Texture>
				</Layer>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("PcAdvertisement"):OnFullClickClose();</OnClick>
				</Scripts>
			</Frame>
			<WebFrame name="$parentAdContentPanel" abs_x="360" abs_y="300" url = "https://fe-test.mini1.cn/adsense/baidu-ad-test.html">
				<Anchors>
					<Anchor point="center" relativePoint="center" relativeTo="$parent">
						<Offset>
							<AbsDimension x="0" y="0" />
						</Offset>
					</Anchor>
				</Anchors>
			</WebFrame>
			<Button name="$parentCloseBtn" framelevel="10000">
				<Size>
					<AbsDimension x="53" y="53"/>
				</Size>
				<Anchors>
					<Anchor point="topleft" relativeTo="$parentAdContentPanel" relativePoint="topright">
						<Offset>
							<AbsDimension x="10" y="-10"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture name="$parentNormal" file="ui/mobile/texture2/common.xml" uvname="btn_close.png" >
					<Size>
						<AbsDimension x="36" y="46"/>
					</Size>
				</NormalTexture>
				<PushedTexture name="$parentPushedBG" file="ui/mobile/texture2/common.xml" uvname="btn_close.png" >
					<Size>
						<AbsDimension x="33" y="43"/>
					</Size>
				</PushedTexture>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("PcAdvertisement"):CloseBtnClicked();</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnEvent>GetInst("UIManager"):GetCtrl("PcAdvertisement"):HandleEvent();</OnEvent>
		</Scripts>
	</Frame>
</Ui>
