<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	##地图房间列表页
	<Script file="ui/mobile/mvc/newOnlineHall/RoomPassWordInput/RoomPassWordInputCtrl.lua"/>
	<Script file="ui/mobile/mvc/newOnlineHall/RoomPassWordInput/RoomPassWordInputModel.lua"/>
	<Script file="ui/mobile/mvc/newOnlineHall/RoomPassWordInput/RoomPassWordInputView.lua"/>


	<Frame name="RoomPassWordInput" parent="UIClient" frameStrata="HIGH" hidden="true" framelevel="2000">
		<Layers>
			<Layer level="background">
				<Texture name="$parentShade" file="ui/white.png" color="80000000" stretchedge="true"/>
				<Texture name="$parentBkg" inherits="TemplateBkg1" abs_x="653" abs_y="338">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>	
				</Texture>
				<Texture name="$parentIcon" file="ui/mobile/ui3.png" x="344" y="412" w="513" h="81" hidden="true">
					<Size>
						<AbsDimension x="578" y="91"/>
					</Size>
					<Anchors>
						<Anchor point="top" relativePoint="top" relativeTo="$parentBkg">
							<Offset>
								<AbsDimension x="0" y="-60"/>
							</Offset>
						</Anchor>
					</Anchors>	
				</Texture>
				<FontString name="$parentText" fonttype="BlackFont30" lineInterval="2" fontStyle="border" text="$582" hidden="true">##
					<Color r="255" g="255" b="255"/>
					<Size>
						<AbsDimension x="280" y="31"/>
					</Size>
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBkg">
							<Offset>
								<AbsDimension x="55" y="94"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<Texture name="$parentUinEditBkg" inherits="TemplateBkg8" abs_x="380" abs_y="46">
					<Anchors>
						<Anchor point="top" relativePoint="top" relativeTo="$parentBkg">
							<Offset>
								<AbsDimension x="0" y="119"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			##标题栏
			<Frame name="$parentTitleFrame" inherits="TemplateTopTitleBkgWithHuaWen01" abs_x="643" abs_y="65">
				<Anchors>
                    <Anchor point="top" relativeTo="$parentBkg" relativePoint="top">
                    	<Offset>
                            <AbsDimension x="-2" y="6"/>
                        </Offset>
                    </Anchor>
                </Anchors>
			</Frame>
			##关闭按钮
            <Button name="$parentCloseBtn" inherits="TemplateCloseBtn0">
                <Anchors>
                    <Anchor point="topright" relativeTo="$parentBkg" relativePoint="topright">
                        <Offset>
                            <AbsDimension x="-11" y="6"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("RoomPassWordInput"):CloseBtn_OnClick();</OnClick>
				</Scripts>
            </Button>
			<SafeEditBox name="$parentPasswordEdit" letters="4" multiLine="false" editMethod="3" editimetype="2" abs_x="360" abs_y="24">
				<Anchors>
					<Anchor point="center" relativeTo="$parentUinEditBkg" relativePoint="center" />
				</Anchors>
				<FontString name="$parentFont" fonttype="BlackFont24"  justifyH="center">
					<Color r="255" g="255" b="255"/>
				</FontString>
				<FontString name="$parentDefault" default="true" fonttype="BlackFont24" text="$582" textcolor="ffb9b9b9" />
				<Scripts>
					<OnEnterPressed platform="pc">GetInst("UIManager"):GetCtrl("RoomPassWordInput"):OnEnterPressed();</OnEnterPressed>
				</Scripts>
			</SafeEditBox>
			##勾选按钮.
			<Button name="$parentCheckBtn" hidden="true" inherits="TemplateTickBtn2" abs_x="150" abs_y="24">
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("RoomPassWordInput"):OnRememberPassword();</OnClick>
				</Scripts>
				<Anchors>
					<Anchor point="bottom" relativeTo="$parentBkg" relativePoint="bottom">
						<Offset>
							<AbsDimension x="-117" y="-120"/>
						</Offset>
					</Anchor>
				</Anchors>

			</Button>
			<Button name="$parentEnterBtn" inherits="TemplateBtn3">
				<Anchors>
					<Anchor point="bottom" relativeTo="$parentBkg" relativePoint="bottom">
						<Offset>
							<AbsDimension x="0" y="-26"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString name="$parentText" fonttype="BlackFont24" justifyH="center" text="$520" abs_x="182" abs_y="24">
							<Color r="55" g="54" b="51"/>
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parent" />
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("RoomPassWordInput"):EnterBtn_OnClick();</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnShow>GetInst("UIManager"):GetCtrl("RoomPassWordInput"):OnShow();</OnShow>
			<OnHide>GetInst("UIManager"):GetCtrl("RoomPassWordInput"):OnHide();</OnHide>
		</Scripts>
	</Frame>
</Ui>