<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	<Script file="ui/mobile/mvc/watermark/WaterMarkModel.lua"/>
	<Script file="ui/mobile/mvc/watermark/WaterMarkView.lua"/>
	<Script file="ui/mobile/mvc/watermark/WaterMarkCtrl.lua"/>

	##定制库鼠标悬浮弹框
	<Frame name="WaterMark" parent="UIClient" frameStrata="HIGH" hidden="true" framelevel="1001" rel_x="1.0" abs_y="20">
		<Anchors>
			<Anchor point="bottom" relativePoint="bottom" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<FontString name="$parentLeftFont" fonttype="BlackFont" alpha = "0.8" fontStyle="shadow" shadowcolor="ff000000" text="A39" abs_x="350" abs_y="16">
					<Color r="204" g="204" b="204"/>
					<Anchors>
						<Anchor point="bottomleft" relativePoint="bottomleft" relativeTo="$parent">
							<Offset>
								<AbsDimension x="4" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentRightFont" fonttype="BlackFont" alpha = "0.8" fontStyle="shadow" shadowcolor="ff000000" text="MINI" abs_x="380" abs_y="16" justifyH="right">
					<Color r="204" g="204" b="204"/>
					<Anchors>
						<Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
							<Offset>
								<AbsDimension x="-4" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		 <Scripts>
		 	<OnShow>GetInst("UIManager"):GetCtrl("WaterMark"):OnShow();</OnShow>
        </Scripts>
	</Frame>
</Ui>