							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					##关闭按钮
					<Button name="$parentCloseBtn" inherits="TemplateCloseBtn0" abs_x="36" abs_y="46">
						<Anchors>
							<Anchor point="topright" relativePoint="topright" relativeTo="$parent">
								<Offset>
									<AbsDimension x="-36" y="33"/>
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnClick>GetInst("UIManager"):GetCtrl("ShareArchiveTopic"):CloseBtnClicked()</OnClick>
						</Scripts>
					</Button>
					##自定义话题输入框
					<SafeEditBox name="$parentTopicEdit" letters="33" multiLine="false" editMethod="527" abs_x="300" abs_y="24">
