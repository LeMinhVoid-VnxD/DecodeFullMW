	##热门话题按钮模板
	<Button name="ShareArchiveTopicHotBtnT" abs_x="142" abs_y="42" virtual="true">
		<Layers>
			<Layer level="overlay">
        		<Texture name="$parentBkg" file="ui/mobile/texture0/team.xml" uvname="btn_team_establish_back" abs_x="142" abs_y="42" DrawType="ninesquare_center">
					<NineSquare ox="0" oy="0" tilew="10" tileh="10"/>
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parentName" justifyH="center" justifyV="middle" fonttype="BlackFont22" text="#话题名称" >
					<Color r="54" g="55" b="49"/>
					<Size>
						<AbsDimension x="100" y="24"/>
					</Size>
					<Anchors>
						<Anchor point="left" relativePoint="left" relativeTo="$parent">
							<Offset>
								<AbsDimension x="20" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>GetInst("UIManager"):GetCtrl("ShareArchiveTopic"):OnTopicHotBtnDown();</OnClick>
		</Scripts>
	</Button>

	##UI主体
	<Frame name="ShareArchiveTopic" parent="UIClient" frameStrata="HIGH" hidden="true" framelevel="3200">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentMask" file="ui/white.png" stretchedge="true" color="8c000000" />
				<Texture name="$parentBkg" inherits="TemplateBigBkg2" abs_x="926" abs_y="496">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="$parentFrame" abs_x="926" abs_y="496">
				<Anchors>
					<Anchor point="center" relativePoint="center" relativeTo="$parentBkg">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						##标题栏
						<FontString name="$parentTitle" fonttype="BlackFont32" text="$25772" abs_x="152" abs_y="38">
							<Color r="77" g="112" b="117"/>
							<Anchors>
								<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
									<Offset>
										<AbsDimension x="61" y="41"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
						##自定义话题
						<FontString name="$parentNameTitle" fonttype="BlackFont24" justifyH="left" text="$25773" abs_x="120" abs_y="26">
							<Color r="77" g="112" b="117"/>
							<Anchors>
								<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
									<Offset>
										<AbsDimension x="61" y="129"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
						<Texture name="$parentTopicEditBkg" inherits="TemplateBkg8" abs_x="340" abs_y="46">
							<Anchors>
								<Anchor point="left" relativePoint="left" relativeTo="$parentNameTitle">
									<Offset>
										<AbsDimension x="147" y="-2"/>
									</Offset>
								</Anchor>
							</Anchors>
						</Texture>
						<FontString name="$parentTopicDefault" fonttype="BlackFont20" justifyH="left" text="$25775" abs_x="300" abs_y="24">
							<Color r="185" g="185" b="185"/>
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parentTopicEditBkg">
									<Offset>
										<AbsDimension x="0" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
						##线
						<Texture name="$parentLine1" file="ui/mobile/texture0/team.xml" uvname="img_team_partingline.png" abs_x="804" abs_y="1" DrawType="center">
							<Anchors>
								<Anchor point="top" relativePoint="top" relativeTo="$parent">
									<Offset>
										<AbsDimension x="0" y="203" />
									</Offset>
								</Anchor>
							</Anchors>
							<Center>
								<Left offsetX="0" offsetY="0" w="4" h="1"/>
								<Center offsetX="4" offsetY="0" w="4" h="1"/>
								<Right offsetX="8" offsetY="0" w="4" h="1"/>
