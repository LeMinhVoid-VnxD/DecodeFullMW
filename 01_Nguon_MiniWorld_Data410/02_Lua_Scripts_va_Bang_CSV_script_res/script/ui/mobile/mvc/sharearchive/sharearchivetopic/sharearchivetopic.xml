						</FontString>
						<Scripts>
							<OnFocusLost>GetInst("UIManager"):GetCtrl("ShareArchiveTopic"):TopicEdit_OnFocusLost();</OnFocusLost>
							<OnClick>GetInst("UIManager"):GetCtrl("ShareArchiveTopic"):TopicEdit_OnClick();</OnClick>
						</Scripts>
					</SafeEditBox>
					##确定按钮
					<Button name="$parentAddTopicBtn" inherits="TemplateBtn2" abs_x="152" abs_y="48">
						<Anchors>
							<Anchor point="left" relativePoint="left" relativeTo="$parentTopicEditBkg">
								<Offset>
									<AbsDimension x="369" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
						<Layers>
							<Layer level="overlay">
								<FontString name="$parentName" justifyH="center" justifyV="middle" fonttype="BlackFont18" text="$969" >
									<Color r="77" g="112" b="117"/>
									<Size>
										<AbsDimension x="100" y="22"/>
									</Size>
									<Anchors>
										<Anchor point="center" relativePoint="center" relativeTo="$parent">
											<Offset>
												<AbsDimension x="0" y="0"/>
											</Offset>
										</Anchor>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
						<Scripts>
							<OnClick>GetInst("UIManager"):GetCtrl("ShareArchiveTopic"):OnTopicBtnDown();</OnClick>
						</Scripts>
					</Button>
