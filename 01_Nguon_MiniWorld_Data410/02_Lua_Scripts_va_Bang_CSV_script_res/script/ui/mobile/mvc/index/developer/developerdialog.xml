                                    <Anchors>
                                        <Anchor point="center" relativePoint="center" relativeTo="$parent"/>
                                    </Anchors>
                                </PushedTexture>
                                <Scripts>
                                    <OnClick>GetInst("UIManager"):GetCtrl("DeveloperDialog"):OnClickSwitchFollow(1)
