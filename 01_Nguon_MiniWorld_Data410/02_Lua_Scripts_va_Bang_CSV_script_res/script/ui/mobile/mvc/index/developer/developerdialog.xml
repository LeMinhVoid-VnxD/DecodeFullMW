                                                    autoadaption="false"
                                                    textcolor="FFD4ECFC" text="$4738">

                                            <Anchors>
                                                <Anchor point="center" relativePoint="center" relativeTo="$parent">
                                                    <Offset>
                                                        <AbsDimension x="0" y="0"/>
                                                    </Offset>
                                                </Anchor>
                                            </Anchors>
                                        </FontString>
                                    </Layer>
                                </Layers>

