<?xml version="1.0" encoding="utf-8" standalone="yes" ?>

<UI>
    <Script file="ui/mobile/mvc/index/developer/DeveloperDialogCtrl.lua" />
    <Script file="ui/mobile/mvc/index/developer/DeveloperDialogView.lua" />
    <Script file="ui/mobile/mvc/index/developer/DeveloperDialogModel.lua" />
    <Button name="DeveloperMapItemTemplate" hidden="false" abs_x="256" abs_y="194" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBg" inherits="TemplateBigBkg9" rel_x="1.0" abs_y="150"/>
            </Layer>
            <Layer level="overlay">

                <Texture name="$parentPicBg" inherits="TemplateBigBkg9" rel_x="1.0" abs_y="150">
                    <Anchors>
                        <Anchor point="top" relativePoint="top" relativeTo="$parent">
