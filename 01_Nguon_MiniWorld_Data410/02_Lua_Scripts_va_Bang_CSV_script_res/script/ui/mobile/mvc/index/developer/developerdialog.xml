                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                            <Offset>
                                <AbsDimension x="0" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>

                <!-- 联机房间状态Start -->
                <Texture name="$parentPeopleBkg" file="ui/mobile/texture2/index.xml" uvname="board_black_number"
                         abs_x="60" abs_y="30">
                    <Anchors>
                        <Anchor point="topright" relativePoint="topright" relativeTo="$parent">
                            <Offset>
                                <AbsDimension x="0" y="1"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
                <Texture name = "$parentIcon" file = "ui/mobile/texture2/index.xml" uvname="icon_people"
                         abs_x = "16" abs_y = "16">
                    <Anchors>
                        <Anchor point="left" relativePoint="left" relativeTo="$parentPeopleBkg">
                            <Offset>
                                <AbsDimension x="8" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
                <FontString name="$parentCurPeople" fonttype="BlackFont20" justifyV="middle" justifyH="left" abs_x="27"
                            abs_y="15" lineInterval="1"  text = "1/6" textcolor = "FFC0CFEA">
                    <Anchors>
                        <Anchor point="left" relativePoint="left" relativeTo="$parentIcon">
                            <Offset>
                                <AbsDimension x="18" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>

            <!-- 活动类型专用图片 -->
            <Layer level="overlay">
                <Texture name="$parentActionPic" hidden="true" file="ui/snap_empty.png" rel_x="1.0" rel_y="1.0">
                    <Anchors>
                        <Anchor point="top" relativePoint="top" relativeTo="$parent">
                            <Offset>
                                <AbsDimension x="0" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>

        <Frames>
            <Button name="$parentBottomFrame" rel_x="1.0" abs_y="46">
                <Anchors>
                    <Anchor point="bottom" relativePoint="bottom" relativeTo="$parent">
                        <Offset>
                            <AbsDimension x="0" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>

                <Layers>
                    <Layer level="overlay">
                        <FontString name="$parentName" justifyV="middle" justifyH="center" abs_x="172" rel_y="1.0"
                                    fonttype="BlackFont24" lineInterval="1" autoadaption="false" textcolor="FF64759D">

                            <Anchors>
                                <Anchor point="center" relativePoint="center" relativeTo="$parent">
                                    <Offset>
                                        <AbsDimension x="0" y="0"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>

                <!-- 这样图片用拼图会出现底下有根黑线，改用png-->
                <NormalTexture name="$parentNormal" file="ui/mobile/texture2/index.xml" uvname = "board_map_text"
                               stretchedge="true" rel_x="1" rel_y="1" DrawType="center">
                    <Center>
                        <Left offsetX="0" offsetY="0" w="90" h="34"/>
                        <Center offsetX="90" offsetY="0" w="12" h="34" />
                        <Right offsetX="102" offsetY="0" w="90" h="34" />
                    </Center>
                </NormalTexture>
                <PushedTexture name="$parentCheckedBG" file="ui/mobile/texture2/index.xml" uvname = "board_map_text"
                               stretchedge="true" color="4d4d4d4d" rel_x="1.0" rel_y="1.0" DrawType="center">
                    <Center>
                        <Left offsetX="0" offsetY="0" w="90" h="34"/>
                        <Center offsetX="90" offsetY="0" w="12" h="34" />
                        <Right offsetX="102" offsetY="0" w="90" h="34" />
                    </Center>
                </PushedTexture>

                <Scripts>
                    <OnClick>GetInst("UIManager"):GetCtrl("DeveloperDialog"):OnClickMap()</OnClick>
                </Scripts>
            </Button>

            <Button name="$parentMaskBtn" rel_x="1" abs_y="150" hidden = "false">
                <Anchors>
                    <Anchor point="top" relativePoint="top" relativeTo="$parent">
                        <Offset>
                            <AbsDimension x="0" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <NormalTexture name="$parentNormal" file="ui/mobile/texture2/index.xml" uvname="mask_friends"
                               color="00000000" rel_x="1" rel_y="1"/>
                <PushedTexture name="$parentCheckedBG" file="ui/mobile/texture2/index.xml" uvname="mask_friends"
                               color="4D4D4D4D" rel_x="1.0" rel_y="1.0"/>
                <Scripts>
                    <OnClick>GetInst("UIManager"):GetCtrl("DeveloperDialog"):OnClickMap()</OnClick>
                </Scripts>
            </Button>
            <Button name="$parentActionMaskBtn" hidden="false" rel_x="1" rel_y="1">
                <NormalTexture name="$parentNormal" file="ui/mobile/texture2/index.xml" uvname="mask_friends"
                               color="00000000" rel_x="1" rel_y="1"/>
                <PushedTexture name="$parentCheckedBG" file="ui/mobile/texture2/index.xml" uvname="mask_friends"
                               color="4D4D4D4D" rel_x="1.0" rel_y="1.0"/>
                <Scripts>
                    <OnClick>GetInst("UIManager"):GetCtrl("DeveloperDialog"):OnClickMap())</OnClick>
                </Scripts>
            </Button>
        </Frames>
    </Button>

    <Frame name="DeveloperDialog" parent="UIClient" frameStrata="HIGH" hidden="true" framelevel="10"
           input_transparent="false">
        <Frames>

            <Frame name="$parentBkg" rel_x="1.0" rel_y="1.0">
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="$parentMask" file="ui/white.png" stretchedge="true" color="99000000"/>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnClick>GetInst("UIManager"):GetCtrl("DeveloperDialog"):OnClickClose()</OnClick>
                </Scripts>
            </Frame>
            <Frame name="$parentDialogFrame" abs_x="890" abs_y="620">
                <Anchors>
                    <Anchor point="center" relativePoint="center" relativeTo="$parent"/>
                </Anchors>

                <Layers>
                    <Layer level="overlay">
                        <Texture name="$parentBkg" file="ui/mobile/texture4/developer.xml" uvname="board_tips_map"
                                 rel_x="1.0" rel_y="1.0" DrawType="ninesquare_center">
                            <NineSquare>
                                <Topleft offsetX="0" offsetY="0" w="6" h="6"/>
                                <Top offsetX="6" offsetY="0" w="38" h="6"/>
                                <Topright offsetX="44" offsetY="0" w="6" h="6"/>
                                <Left offsetX="0" offsetY="6" w="6" h="38"/>
                                <Center offsetX="6" offsetY="6" w="38" h="38"/>
                                <Right offsetX="44" offsetY="6" w="6" h="38"/>
                                <Bottomleft offsetX="0" offsetY="44" w="6" h="6"/>
                                <Bottom offsetX="6" offsetY="44" w="38" h="6"/>
                                <Bottomright offsetX="44" offsetY="44" w="6" h="6"/>
                                <OffSet x="0" y="0"/>
                            </NineSquare>
                        </Texture>

                        <Texture name="$parentTitleBkg" file="ui/mobile/texture4/developer.xml" uvname="img_title"
                                 rel_x="1.0" abs_y="61"/>

                        <!-- 标题 -->
                        <FontString name="$parentTitle" justifyH="center" justifyV="middle" textcolor="FFEAF8F9"
                                    fonttype="BlackFont28" rel_x="1.0" abs_y="61" text="MINI DEVELOPER">
                            <Anchors>
                                <Anchor point="center" relativePoint="center" relativeTo="$parentTitleBkg"/>
                            </Anchors>
                        </FontString>

                        <!-- 星球等级图片 -->
                        <Texture name="$parentStartLevel" file="ui/mobile/texture4/developer.xml"
                                 uvname="icon_stardust" abs_x="850" abs_y="192">
                            <Anchors>
                                <Anchor point="top" relativePoint="bottom" relativeTo="$parentTitleBkg">
                                    <Offset>
                                        <AbsDimension x="0" y="13"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </Texture>

                        <!-- 开发者头像背景 -->
                        <Texture name="$parentAuthorBkg" file="ui/mobile/texture4/developer.xml" abs_x="90" abs_y="90"
                                 uvname="frame_friends">
                            <Anchors>
                                <Anchor point="left" relativePoint="left" relativeTo="$parentStartLevel">
                                    <Offset>
                                        <AbsDimension x="31" y="0"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </Texture>

                        <Texture name="$parentAuthor" file="ui/roleicons/1000.png" abs_x="86" abs_y="86">
                            <Anchors>
                                <Anchor point="center" relativePoint="center" relativeTo="$parentAuthorBkg"/>
                            </Anchors>
                        </Texture>

                        <Texture name="$parentUinIcon" file="ui/mobile/texture4/developer.xml" uvname="icon_uid"
                                 abs_x="30" abs_y="30">
                            <Anchors>
                                <Anchor point="bottomleft" relativePoint="bottomright" relativeTo="$parentAuthorBkg">
                                    <Offset>
                                        <AbsDimension x="14" y="-10"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </Texture>

                        <FontString name="$parentUin" textcolor="FFF8FAFF" fonttype="BlackFont20" justifyH="left"
                                    justifyV="middle" abs_x="200" abs_y="20">
                            <Anchors>
                                <Anchor point="left" relativePoint="right" relativeTo="$parentUinIcon">
                                    <Offset>
                                        <AbsDimension x="4" y="0"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </FontString>

                        <FontString name="$parentName" textcolor="FFF8FAFF" fonttype="BlackFont24" abs_x="200"
                                    abs_y="24" justifyH="left" justifyV="middle">
                            <Anchors>
                                <Anchor point="bottomleft" relativePoint="topleft" relativeTo="$parentUinIcon">
                                    <Offset>
                                        <AbsDimension x="0" y="-16"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </FontString>

