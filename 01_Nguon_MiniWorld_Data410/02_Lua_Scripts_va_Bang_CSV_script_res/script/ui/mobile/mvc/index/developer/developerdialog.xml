                    <Anchors>
                        <Anchor point="bottom" relativePoint="bottom" relativeTo="$parentPic">
                            <Offset>
                                <AbsDimension x="0" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>

                <!-- 地图图片边框 -->
                <Texture name="$parentPicBoard" file="ui/mobile/texture2/index.xml" uvname="board_map_small" abs_x="256"
                         abs_y="150" hidden = "true">
                    <Anchors>
                        <Anchor point="top" relativePoint="top" relativeTo="$parentPicBg">
                            <Offset>
                                <AbsDimension x="0" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>

                <!--热度提示-->
                <FontString name="$parentHeats" fonttype="BlackFont18" justifyV="middle" justifyH="left" abs_x="42"
