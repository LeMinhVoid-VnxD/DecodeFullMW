                                </Scripts>
                            </Button>

                            <Button name="$parentUnFollowBtn" abs_x="198" abs_y="65" hidden="true">
                                <Anchors>
                                    <Anchor point="top" relativePoint="top" relativeTo="$parent"/>
                                </Anchors>

                                <Layers>
                                    <Layer level="overlay">
                                        <FontString name="$parentName" justifyV="middle" justifyH="center" rel_x="1.0"
                                                    rel_y="1.0" fonttype="BlackFont28" lineInterval="1"
                                                    autoadaption="false"
                                                    textcolor="FF718AB9" text="$521">

                                            <Anchors>
                                                <Anchor point="center" relativePoint="center" relativeTo="$parent">
                                                    <Offset>
                                                        <AbsDimension x="0" y="0"/>
                                                    </Offset>
                                                </Anchor>
                                            </Anchors>
                                        </FontString>
                                    </Layer>
                                </Layers>

                                <NormalTexture name="$parentNormal" file="ui/mobile/texture4/developer.xml"
                                               uvname="btn_unfollow"/>
                                <PushedTexture name="$parentPushedBG" file="ui/mobile/texture4/developer.xml"
                                               uvname="btn_unfollow" abs_x="190" abs_y="60">
                                    <Anchors>
                                        <Anchor point="center" relativePoint="center" relativeTo="$parent"/>
                                    </Anchors>
                                </PushedTexture>
                                <Scripts>
                                    <OnClick>GetInst("UIManager"):GetCtrl("DeveloperDialog"):OnClickSwitchFollow(2)
                                    </OnClick>
                                </Scripts>
                            </Button>
                        </Frames>
                    </Frame>
