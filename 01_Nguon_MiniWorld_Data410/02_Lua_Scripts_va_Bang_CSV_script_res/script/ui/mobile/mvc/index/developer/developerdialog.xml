                                 uvname="board_tips_explain" DrawType="ninesquare_center">
                            <NineSquare ox="0" oy="0" tilew="6" tileh="6"/>
                            <Anchors>
                                <Anchor point="topleft" relativePoint="bottomleft" relativeTo="$parentMapsHits">
                                    <Offset>
                                        <AbsDimension x="-24" y="12"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>

                <Frames>

                    <ListViewFrame name="$parentMapList" slidingY="true" slideplane="$parentPlane" abs_x="804"
                                   abs_y="250">
                        <Anchors>
                            <Anchor point="center" relativePoint="center" relativeTo="$parentMapsBkg"/>
                        </Anchors>

                        <Frames>
                            <Frame name="$parentPlane" abs_x="804" abs_y="250">
                                <Anchors>
                                    <Anchor point="top" relativePoint="top" relativeTo="$parent">
                                        <Offset>
                                            <AbsDimension x="0" y="0"/>
                                        </Offset>
                                    </Anchor>
                                </Anchors>
                            </Frame>
                        </Frames>
                    </ListViewFrame>
                    <Frame name="$parentFollowFrame" abs_x="198" abs_y="90">
                        <Anchors>
                            <Anchor point="right" relativePoint="right" relativeTo="$parentStartLevel">
                                <Offset>
                                    <AbsDimension x="-37" y="0"/>
                                </Offset>
                            </Anchor>
                        </Anchors>

                        <Layers>
                            <Layer level="overlay">
                                <FontString name="$parentFollowers" textcolor="FFD2EBFB" fonttype="BlackFont20"
