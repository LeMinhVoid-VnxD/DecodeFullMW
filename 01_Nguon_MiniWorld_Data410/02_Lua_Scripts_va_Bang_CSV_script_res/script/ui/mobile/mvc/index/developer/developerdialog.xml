                </FontString>

                <Texture name="$parentIconHeats" file="ui/mobile/texture2/index.xml" uvname="icon_people" abs_x="16"
                         abs_y="18" color="FFD1D1D1">
                    <Anchors>
                        <Anchor point="bottomright" relativePoint="bottomleft" relativeTo="$parentHeats">
                            <Offset>
                                <AbsDimension x="-4" y="-2"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>

                <!-- 角标背景 -->
                <Texture name="$parentIconSubscript" file="ui/mobile/texture2/index.xml" uvname="label_hot_small"
                         abs_x="45" abs_y="38">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                            <Offset>
                                <AbsDimension x="0" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>

                <!-- 角标背景文字 -->
                <Texture name="$parentTextSubscript" file="ui/mobile/texture2/index.xml" uvname="image_text_eng_hot"
