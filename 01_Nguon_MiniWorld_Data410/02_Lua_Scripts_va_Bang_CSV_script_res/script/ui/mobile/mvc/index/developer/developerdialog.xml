                                <AbsDimension x="0" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>

                <!-- 地图图片 -->
                <Texture name="$parentPic" file="ui/snap_empty.png" abs_x="256" abs_y="148">
                    <Anchors>
                        <Anchor point="center" relativePoint="center" relativeTo="$parentPicBg">
                            <Offset>
                                <AbsDimension x="0" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>

                <!--文本提示标识-->
