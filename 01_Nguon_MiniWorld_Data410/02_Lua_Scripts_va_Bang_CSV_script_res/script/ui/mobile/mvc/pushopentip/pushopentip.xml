<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	<Frame name="PushOpenTip" parent="UIClient" frameStrata="HIGH" hidden="true" framelevel="2" input_transparent="false">
		<Size>
			<RelDimension x="1.0" y="1.0"/>
		</Size>
		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent" />
		</Anchors>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentMask" file="ui/white.png" color="B1000000" stretchedge="true">
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="MiniContentBkg">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
						<Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentBkg" abs_x="653" abs_y="408" file="ui/mobile/texture0/pushopentip.xml" uvname="img_broad_push">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		
		<Frames>
			<Frame name = "Black" abs_x = "653" abs_y = "408">
				<Anchors>
					<Anchor point="center" relativePoint="center" relativeTo="$parent" />
				</Anchors>
			</Frame>
			<Frame name="$parentTitle" abs_x = "653" abs_y="80">
				<Anchors>
					<Anchor point="top" relativeTo="$parentBkg" relativePoint="top"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<FontString name="$parentName" fonttype="BlackFont30" justifyH="center" justifyV="middle" text="$1000027" abs_x="117" abs_y="29">
							<Color r="78" g="113" b="136"/> 
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parent">
									<Offset>
										<AbsDimension x="0" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>

			<Frame name = "$parentContent" abs_x = "571" abs_y = "200" >
				<Anchors>
					<Anchor point="center" relativeTo="$parentBkg" relativePoint="center">
						<Offset>
							<AbsDimension x="0" y="-5"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer>
						<FontString name="$parentTipText" fonttype="BlackFont22" text="$1000022" abs_x="571" abs_y = "190" lineInterval="15"
							autowrap="true" >
							<Color r="78" g="113" b="136"/> 
							<Anchors>
								<Anchor point="top" relativePoint="top" relativeTo="$parent">
									<Offset>
										<AbsDimension x="0" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Frame>

			<Frame name = "$parentOpen" abs_x = "198" abs_y = "65" hidden = "false">
				<Anchors>
					<Anchor point="bottom" relativeTo="$parentBkg" relativePoint="bottom">
						<Offset>
							<AbsDimension y="-31"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Frames>
					<Button name = "$parentOpenBtn" hidden = "false" abs_x="198" abs_y="65">
						<Anchors>
							<Anchor point = "center" relativePoint = "center" relativeTo = "$parent">
								<Offset>
									<AbsDimension x="0" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
						<Layers>						
							<Layer level = "overlay">
								<FontString name="$parentText" fonttype="BlackFont28" text="$1000023" abs_x="186" abs_y="26" justifyH="center" 
									justifyV="middle">
									<Anchors>
										<Anchor point="center" relativePoint="center" relativeTo="$parent">
											<Offset>
												<AbsDimension x="0" y="0"/>
											</Offset>
										</Anchor>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
						<NormalTexture name="$parentNormal" file = "ui/mobile/texture0/pushopentip.xml" uvname="btn_join.png"/>
						<PushedTexture name="$parentPushedBG" file = "ui/mobile/texture0/pushopentip.xml" uvname="btn_join.png"
							 abs_x="185" abs_y="60">
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parent">
									<Offset>
										<AbsDimension x="0" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</PushedTexture>
						<Scripts>
							<OnClick>GetInst("UIManager"):GetCtrl("PushOpenTip"):OnPushOpenTipOpenClick();</OnClick>
						</Scripts>
					</Button>
				</Frames>
			</Frame>

			<Frame name = "$parentClose" abs_x = "50" abs_y = "50" >
				<Anchors>
					<Anchor point="topright" relativeTo="$parentBkg" relativePoint="topright">
						<Offset>
							<AbsDimension x="-15" y="15"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Frames>
					<Button name = "$parentCloseBtn" abs_x="50" abs_y="50">
						<Anchors>
							<Anchor point = "topright" relativePoint = "topright" relativeTo = "$parent">
								<Offset>
									<AbsDimension x="0" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
						<NormalTexture name="$parentNormal" file="ui/mobile/texture0/pushopentip.xml" uvname="btn_close.png"
									   abs_x="51" abs_y="51">
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parent">
								</Anchor>
							</Anchors>
						</NormalTexture>
						<PushedTexture name="$parentCheckedBG" file="ui/mobile/texture0/pushopentip.xml" uvname="btn_close.png"
							rel_x="0.9" rel_y="0.9">
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parent"/>
							</Anchors>
						</PushedTexture>
						<Scripts>
							<OnClick>GetInst("UIManager"):GetCtrl("PushOpenTip"):OnPushOpenTipCloseClick();</OnClick>
						</Scripts>
					</Button>
				</Frames>
			</Frame>
		</Frames>
		<Scripts>
			<OnClick>GetInst("UIManager"):GetCtrl("PushOpenTip"):OnPushOpenTipCloseClick();</OnClick>
		</Scripts>
	</Frame>
</Ui>
