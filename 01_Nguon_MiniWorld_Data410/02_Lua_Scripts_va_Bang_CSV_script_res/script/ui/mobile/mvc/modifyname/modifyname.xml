<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	<Script file="ui/mobile/mvc/modifyname/ModifyNameModel.lua"/>
	<Script file="ui/mobile/mvc/modifyname/ModifyNameView.lua"/>
	<Script file="ui/mobile/mvc/modifyname/ModifyNameCtrl.lua"/>

	##修改名字弹框
	<Frame name="ModifyName" parent="UIClient" frameStrata="MEDIUM" hidden="true" framelevel="1011">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBkg" file="ui/white.png" stretchedge="true" color="80000000"/>

				<Texture name="$parentChenDi" inherits="TemplateBkg1" abs_x="653" abs_y="338">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>
				</Texture>
				<Texture name="$parentBkgIcon" file="ui/mobile/texture2/messagebox.xml" uvname="popup_clip.png" abs_x="105" abs_y="100" >
					<Anchors>
						<Anchor point="top" relativePoint="top" relativeTo="$parentBkg">
							<Offset>
								<AbsDimension x="-300" y="169"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentEditBkg" inherits="TemplateBkg8" abs_x="515" abs_y="150">
					<Anchors>
						<Anchor point="top" relativePoint="top" relativeTo="$parentBkg">
							<Offset>
								<AbsDimension x="0" y="270"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentCloseBtn" inherits="TemplateCloseBtn">
				<Anchors>
					<Anchor point="topright" relativePoint="topright" relativeTo="$parentChenDi">
						<Offset>
							<AbsDimension x="-27" y="16"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>GetInst("UIManager"):Close("ModifyName")</OnClick>
				</Scripts>
			</Button>
			<SafeMultiEditBox name="$parentTextEdit" letters="250" multiLine="false" editMethod="527" abs_x="495" abs_y="130">
				<Anchors>
					<Anchor point="center" relativeTo="$parentEditBkg" relativePoint="center">
						<Offset>
							<AbsDimension x="0" y="0" />
						</Offset>
					</Anchor>
				</Anchors>
				<textcolor r="255" g="255" b="255"/>
				<FontString name="$parentFont" fonttype="BlackFont24" >
					<Color r="255" g="255" b="255"/>
				</FontString>
				<FontString name="$parentDefault" justifyH="left" default="true" fonttype="BlackFont24" text="$9233" textcolor="ffd1bc89"/>
				<Scripts>
					<OnFocusGained>GetInst("UIManager"):GetCtrl("ModifyName"):OnTextEditFocusGained();</OnFocusGained>
					<OnFocusLost>GetInst("UIManager"):GetCtrl("ModifyName"):OnTextEditOnFocusLost();</OnFocusLost>
				</Scripts>
			</SafeMultiEditBox>
			<Button name="$parentSureBtn" inherits="TemplateBtn3">
				<Anchors>
					<Anchor  point="top" relativePoint="bottom" relativeTo="$parentBkg">
						<Offset>
							<AbsDimension x="0" y="-280" />
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="overlay">
						<FontString name="$parentName" fonttype="BlackFont24" justifyH="center" justifyV="middle" text="$3952" abs_x="200" abs_y="40" >
							<Color r="55" g="54" b="49"/>
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parent">
									<Offset>
										<AbsDimension x="0" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("ModifyName"):SureBtnClick()</OnClick>
				</Scripts>
			</Button>
		</Frames>
	</Frame>
</Ui>