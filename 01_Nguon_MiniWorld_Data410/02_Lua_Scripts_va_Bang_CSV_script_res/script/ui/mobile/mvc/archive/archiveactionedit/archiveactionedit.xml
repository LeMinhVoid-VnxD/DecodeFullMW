			<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" >
				<Offset>
					<AbsDimension x="0" y="20"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				##LLDO:红点
				<Texture name="$parentRedTag" file="ui/mobile/texture2/common.xml" uvname="img_dot_tips" hidden="true" abs_x="20" abs_y="20">
					<Anchors>
						<Anchor point="topright" relativePoint="topright" relativeTo="$parent">
							<Offset>
								<AbsDimension x="-5" y="5"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick>GetInst("UIManager"):GetCtrl("ArchiveActionEdit"):leftTabBtnClicked();</OnClick>
		</Scripts>
