<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
    <Script file="ui/mobile/mvc/ActivityConcert/ActivityConcertMgr.lua" />
    <Script file="ui/mobile/mvc/ActivityConcert/ActivityConcertFacePic/ActivityConcertFacePicCtrl.lua" />
    <Script file="ui/mobile/mvc/ActivityConcert/ActivityConcertFacePic/ActivityConcertFacePicView.lua" />
    <Script file="ui/mobile/mvc/ActivityConcert/ActivityConcertFacePic/ActivityConcertFacePicModel.lua" />

	<!-- 音乐会活动拍脸图 -->
	<Frame name="ActivityConcertFacePic" parent="UIClient" frameStrata="MEDIUM" hidden="false" framelevel="1750">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentMask" file="ui/white.png" color="B1000000" stretchedge="true" />
				<Texture name="$parentFacePic" file="ui/snap_empty.png" abs_x="1061" abs_y="694">
                    <Anchors>
                        <Anchor point="center" relativeTo="$parent" relativePoint="center"/>
                    </Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentCloseBtn" abs_x="54" abs_y="54">
				<Anchors>
					<Anchor point="topright" relativeTo="$parentFacePic" relativePoint="topright">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture name="$parentNormal" file="ui/mobile/texture2/common.xml" uvname="btn_close_banner.png" />
				<PushedTexture name="$parentPushedBG" file="ui/mobile/texture2/common.xml" uvname="btn_close_banner.png" >
					<Size>
						<AbsDimension x="50" y="50"/>
					</Size>
					<Anchors>
						<Anchor point="center" relativeTo="$parent" relativePoint="center">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</PushedTexture>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("ActivityConcertFacePic"):CloseView_OnClick()</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentGotoActivityBtn" abs_x="241" abs_y="129">
				<Anchors>
					<Anchor point="bottomright" relativeTo="$parentFacePic" relativePoint="bottomright">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture name="$parentNormal" file="ui/mobile/texture0/bigtex/btn_recharge_2.png" />
				<PushedTexture name="$parentPushedBG" file="ui/mobile/texture0/bigtex/btn_recharge_2.png" rel_x="0.95" rel_y="0.95">
					<Anchors>
						<Anchor point="center" relativeTo="$parent" relativePoint="center">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</PushedTexture>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("ActivityConcertFacePic"):GotoActivity_Onclick()</OnClick>
				</Scripts>
			</Button>
		</Frames>
	</Frame>
</Ui>