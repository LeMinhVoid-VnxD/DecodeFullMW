<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	<Script file="ui/mobile/mvc/strongpopup/StrongPopupModel.lua"/>
	<Script file="ui/mobile/mvc/strongpopup/StrongPopupView.lua"/>
	<Script file="ui/mobile/mvc/strongpopup/StrongPopupCtrl.lua"/>

	<Frame name="StrongPopup" parent="UIClient" frameStrata="HIGH" framelevel="1001">
		<Size>
			<RelDimension x="1.0" y="1.0"/>
		</Size> 
		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0" />
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBgMask" file="ui/white.png" color="80000000" stretchedge="true" framelevel="1002">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentBg" file="ui/white.png" abs_x="800" abs_y="600" framelevel="1004">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="$parentPictureBtn" framelevel="1002" abs_x="800" abs_y="600">
				<Anchors>
					<Anchor point="center" relativePoint="center" relativeTo="$parent">
						<Offset>
							<AbsDimension x="0" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("StrongPopup"):PictureOnClicked();</OnClick>
				</Scripts>
			</Frame>
			<Button name="$parentCloseBtn" framelevel="1003">
				<Size>
					<AbsDimension x="53" y="53"/>
				</Size>
				<Anchors>
					<Anchor point="bottomleft" relativeTo="$parentBg" relativePoint="topright">
						<Offset>
							<AbsDimension x="-6" y="6"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture name="$parentNormal" file="ui/mobile/texture2/common.xml" uvname="btn_close_banner.png" />
				<PushedTexture name="$parentPushedBG" file="ui/mobile/texture2/common.xml" uvname="btn_close_banner.png" >
					<Size>
						<AbsDimension x="50" y="50"/>
					</Size>
					<Anchors>
						<Anchor point="center" relativeTo="$parent" relativePoint="center">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</PushedTexture>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("StrongPopup"):CloseBtnClicked();</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnShow>GetInst("UIManager"):GetCtrl("StrongPopup"):OnShow();</OnShow>
			<OnHide>GetInst("UIManager"):GetCtrl("StrongPopup"):OnHide();</OnHide>
		</Scripts>
	</Frame>
</Ui>
