			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="overlay">
				<Texture name="$parentModelBkg" inherits="TemplateBkg83" abs_x="200" abs_y="38">
					<Anchors>
						<Anchor point="bottom" relativePoint="bottom" relativeTo="$parent">
