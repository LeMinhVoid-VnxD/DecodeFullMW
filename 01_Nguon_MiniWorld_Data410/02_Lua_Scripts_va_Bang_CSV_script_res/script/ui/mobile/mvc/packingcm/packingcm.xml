			<Layer level="overlay" >
				<Texture name="$parentChecked" inherits="TemplateBkg71" rel_x="0.85" rel_y="0.85" hidden="true">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<NormalTexture name="$parentNormal" file="ui/mobile/texture0/operate.xml" uvname="operating_board_square.png" hidden="true"/>
