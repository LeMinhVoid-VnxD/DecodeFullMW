	<Frame name="MiniWorksPopupsTipTemplate" virtual="true" abs_x="380" abs_y="518" >
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBg" inherits="TemplateGrayFrameBkg" rel_x="1" rel_y="1"/>
