					<Anchors>
						<Anchor point="top" relativeTo="$parent" relativePoint="top"/>
					</Anchors>
				</Texture>
				<Texture name="$parentBkg" file="ui/mobile/texture2/bigtex/img_placeholder.png" abs_x="300" abs_y="252">
					<Anchors>
						<Anchor point="center" relativeTo="$parent" relativePoint="center" />
					</Anchors>
				</Texture>
				<Texture name="$parentBottom" inherits="TemplateBkg26" abs_x="380" abs_y="60">
					<Anchors>
						<Anchor point="bottom" relativeTo="$parent" relativePoint="bottom"/>
					</Anchors>
				</Texture>
				<FontString name="$parentDefult" fonttype="BlackFont26" justifyH="center" justifyV="middle" text="$3153">
					<Color r="61" g="69" b="70"/>
					<Size>
						<AbsDimension x="380" y="26"/>
					</Size>
					<Anchors>
						<Anchor point="center" relativeTo="$parentBottom" relativePoint="center"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentMainBtn" abs_x="380" abs_y="518">
				<Anchors>
					<Anchor point="top" relativePoint="top" relativeTo="$parent"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture name="$parentBkg" file="ui/white.png" hidden="true" />
					</Layer>
				</Layers>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("MiniWorksPopups"):ShowPictureDetail();</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentViewBtn" abs_x="182" abs_y="61">
