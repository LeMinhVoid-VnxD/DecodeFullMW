					</Layer>
				</Layers>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("MiniWorksPopups"):CloseBtn_OnClick();</OnClick>
				</Scripts>
			</Button>
			<Frame name="$parentTip1" inherits="MiniWorksPopupsTipTemplate" id="1">
				<Anchors>
					<Anchor point="right" relativePoint="left" relativeTo="$parentTip2">
