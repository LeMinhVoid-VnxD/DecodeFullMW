							<AbsDimension x="0" y="21"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture name="$parentNormal" inherits="TemplateBkg3"/>
				<PushedTexture name="$parentPushedBG" inherits="TemplateBkg3" rel_x="0.9" rel_y="0.9">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>
				</PushedTexture>
				<Layers>
					<Layer level="overlay">
						<FontString name="$parentName" fonttype="BlackFont24" rel_x="0.9" rel_y="0.9" justifyV="middle" justifyH="center" text="$3034">
							<Color r="55" g="54" b="51"/>
							<Anchors>
								<Anchor point="center" relativePoint="center"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("MiniWorksPopups"):ShowPictureDetail();</OnClick>
				</Scripts>
			</Button>
		</Frames>
