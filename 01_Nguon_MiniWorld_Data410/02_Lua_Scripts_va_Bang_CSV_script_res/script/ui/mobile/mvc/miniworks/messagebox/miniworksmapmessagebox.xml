<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	##迷你工坊首页
	<Script file="ui/mobile/mvc/miniworks/messagebox/MiniWorksMapMessageBoxModel.lua"/>
	<Script file="ui/mobile/mvc/miniworks/messagebox/MiniWorksMapMessageBoxView.lua"/>
	<Script file="ui/mobile/mvc/miniworks/messagebox/MiniWorksMapMessageBoxCtrl.lua"/>

	<Frame name="MiniWorksMapMessageBox" parent="UIClient" frameStrata="HIGH" hidden="true" framelevel="7000" input_transparent="false">
		<Size>
			<RelDimension x="1.0" y="1.0"/>
		</Size>
		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBkg" file="ui/white.png" stretchedge="true" color="40000000"/>
				<Texture name="$parentChenDi" inherits="TemplateBkg1" abs_x="787" abs_y="419">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentClipIcon" file="ui/mobile/texture2/messagebox.xml" uvname="popup_clip.png" abs_x="105" abs_y="100">
					<Anchors>
						<Anchor point="topleft" relativeTo="$parentChenDi" relativePoint="topleft">
							<Offset>
								<AbsDimension x="-19" y="-22" />
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentCloseBtn" inherits="TemplateCloseBtn">
				<Anchors>
					<Anchor point="topright" relativePoint="topright" relativeTo="$parentChenDi">
						<Offset>
							<AbsDimension x="-27" y="16"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("MiniWorksMapMessageBox"):CloseBtnClicked();</OnClick>
				</Scripts>
			</Button>
			<RichText name="$parentContent" lineInterval="2" multiLine="false" fonttype="BlackFont22" autoextend="true" abs_x="654" abs_y="220">
				<Anchors>
					<Anchor point="topleft" relativeTo="$parentChenDi" relativePoint="topleft">
						<Offset>
							<AbsDimension x="72" y="80" />
						</Offset>
					</Anchor>
				</Anchors>
			</RichText>
			<Button name="$parentConfirmBtn" inherits="TemplateBtn3">
				<Anchors>
					<Anchor point="bottom" relativeTo="$parentChenDi" relativePoint="bottom">
						<Offset>
							<AbsDimension x="0" y="-26"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="overlay">
						<FontString name="$parentName" fonttype="BlackFont24" justifyH="center" abs_x="180" abs_y="26" text="$3010">
							<Color r="55" g="54" b="51"/>
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parent">
									<Offset>
										<AbsDimension x="0" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("MiniWorksMapMessageBox"):ConfirmBtnClicked();</OnClick>
				</Scripts>
			</Button>
		</Frames>

		<Scripts>
			<OnEvent>GetInst("UIManager"):GetCtrl("MiniWorksMapMessageBox"):HandleEvent();</OnEvent>
		</Scripts>
	</Frame>
</Ui>