<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Ui>
	<Script file="ui/mobile/mvc/NewBattlePass/NewBPSeasonShow/NewBPSeasonShowCtrl.lua" />
	<Script file="ui/mobile/mvc/NewBattlePass/NewBPSeasonShow/NewBPSeasonShowModel.lua" />
	<Script file="ui/mobile/mvc/NewBattlePass/NewBPSeasonShow/NewBPSeasonShowView.lua" />

	<!--NewBattlePass 新赛季特写展示界面-->
	<Frame name="NewBPSeasonShow" parent="UIClient" frameStrata="MEDIUM" hidden="true" framelevel="9999">
		<Size>
			<RelDimension x="1.0" y="1.0" />
		</Size>
		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent" />
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentMask" file="ui/white.png" stretchedge="true" color="d0000000" />
				<Texture name="$parentBkg" file="ui/mobile/texture0/bigtex/bg_saijibeijing_bp.png">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>
				</Texture>
				<Texture name="$parentBkgLogo" file="ui/mobile/texture0/bigtex/bg_saijitubiao_bp.png" abs_x="718" abs_y="720">
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent" />
					</Anchors>
				</Texture>
				<Texture name="$parentTipBkg" file="ui/mobile/texture0/bigtex/img_tips_victory.png" color="80000000">
					<Size>
						<AbsDimension x="399" y="46"/>
					</Size>
					<Anchors>
						<Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="-18"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<FontString name="$parentTips" fonttype="BlackFont24" justifyH="center" justifyV="middle" text="$70506" abs_x="200" abs_y="24">
					<Color r="219" g="219" b="219" />
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parentTipBkg">
							<Offset>
								<AbsDimension x="0" y="2" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>			
			</Layer>
		</Layers>
		<Frames>
			<!--BattlePass最终大奖展示-->
			<Frame name="$parentActorPanel" rel_x="1.0" rel_y="1.0" hidden="true">
				<Anchors>
					<Anchor point="center" relativeTo="$parent" relativePoint="center">
						<Offset>
							<AbsDimension x="0" y="0" />
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture name="$parentLogo" file="ui/mobile/texture0/bigtex/bg_logo_bp.png" abs_x="220" abs_y="206">
							<Anchors>
								<Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
									<Offset>
										<AbsDimension x="10" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</Texture>				
						<Texture name="$parentNameBg" file="ui/mobile/texture0/bigtex/bg_name1_bp.png" abs_x="332" abs_y="98">
							<Anchors>
								<Anchor point="bottom" relativePoint="bottom" relativeTo="$parent">
									<Offset>
										<AbsDimension x="-220" y="-86"/>
									</Offset>
								</Anchor>
							</Anchors>
						</Texture>
						<FontString name="$parentName" fonttype="BlackFont20" justifyH="center" justifyV="middle" abs_x="230" abs_y="20">
							<Color r="255" g="255" b="255" />
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parentNameBg">
									<Offset>
										<AbsDimension x="40" y="0" />
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>	
						<Texture name="$parentNameBg_Right" file="ui/mobile/texture0/bigtex/bg_name1_bp.png" abs_x="332" abs_y="98">
							<Anchors>
								<Anchor point="bottom" relativePoint="bottom" relativeTo="$parent">
									<Offset>
										<AbsDimension x="270" y="-86"/>
									</Offset>
								</Anchor>
							</Anchors>
						</Texture>	
						<FontString name="$parentNameRight" fonttype="BlackFont20" justifyH="center" justifyV="middle" abs_x="230" abs_y="20">
							<Color r="255" g="255" b="255" />
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parentNameBg_Right">
									<Offset>
										<AbsDimension x="40" y="0" />
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>					
						<ModelView name="$parentView" rel_x="1.0" rel_y="1.0" />
						<ModelView name="$parentViewRight" rel_x="1.0" rel_y="1.0" />
					</Layer>
				</Layers>
				<Frames>
					<Button name="$parentRotateBtn" rel_x="0.5" rel_y="0.6">
						<Anchors>
							<Anchor point="right" relativeTo="$parent" relativePoint="center">
								<Offset>
									<AbsDimension x="0" y="0" />
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnMouseDown>GetInst("UIManager"):GetCtrl("NewBPSeasonShow"):RotateBtnMouseDown()</OnMouseDown>
							<OnMouseMove>GetInst("UIManager"):GetCtrl("NewBPSeasonShow"):RotateBtnMouseMove()</OnMouseMove>
						</Scripts>
					</Button>
					<Button name="$parentRotateRightBtn" rel_x="0.5" rel_y="0.6">
						<Anchors>
							<Anchor point="left" relativeTo="$parent" relativePoint="center">
								<Offset>
									<AbsDimension x="0" y="0" />
								</Offset>
							</Anchor>
						</Anchors>
						<Scripts>
							<OnMouseDown>GetInst("UIManager"):GetCtrl("NewBPSeasonShow"):RotateBtnMouseDown_Right()</OnMouseDown>
							<OnMouseMove>GetInst("UIManager"):GetCtrl("NewBPSeasonShow"):RotateBtnMouseMove_Right()</OnMouseMove>
						</Scripts>
					</Button>
				</Frames>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("NewBPSeasonShow"):CloseBPSeasonShow()</OnClick>
				</Scripts>
			</Frame>
		</Frames>		
		<Scripts>
			<OnClick>GetInst("UIManager"):GetCtrl("NewBPSeasonShow"):CloseBPSeasonShow()</OnClick>
		</Scripts>
	</Frame>
</Ui>