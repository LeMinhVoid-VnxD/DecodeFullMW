		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0" />
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBkg" file="ui/mobile/texture0/newbattlepass.xml" uvname="board_bule1" abs_x="672" abs_y="559" DrawType="ninesquare">
				<NineSquare>
						<Topleft 		offsetX="0" 	offsetY="0" 	w="44" 	h="44"/>
						<Top 			offsetX="44" 	offsetY="0" 	w="10"  h="44"/>
						<Topright 		offsetX="54" 	offsetY="0" 	w="44" 	h="44"/>
						<Left 			offsetX="0" 	offsetY="44" 	w="44" 	h="10"/>
