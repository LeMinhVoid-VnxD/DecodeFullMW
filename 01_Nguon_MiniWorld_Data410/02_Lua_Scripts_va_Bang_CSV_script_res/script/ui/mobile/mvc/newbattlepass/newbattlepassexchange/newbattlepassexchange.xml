							<Offset>
								<AbsDimension x="-90" y="112" />
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			## 任务滚动列表
			<ListViewFrame name="$parentList" slidingY="true" slideplane="$parentPlane" abs_x="647" abs_y="474">
				<Anchors>
					<Anchor point="top" relativePoint="top" relativeTo="$parentBkg">
						<Offset>
							<AbsDimension x="8" y="40"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Frames>
					<Frame name="$parentPlane" abs_x="647" abs_y="474">
						<Anchors>
							<Anchor point="topleft" relativeTo="$parent" relativePoint="topleft">
								<Offset>
									<AbsDimension x="0" y="0" />
								</Offset>
							</Anchor>
						</Anchors>
					</Frame>
				</Frames>
			</ListViewFrame>	
