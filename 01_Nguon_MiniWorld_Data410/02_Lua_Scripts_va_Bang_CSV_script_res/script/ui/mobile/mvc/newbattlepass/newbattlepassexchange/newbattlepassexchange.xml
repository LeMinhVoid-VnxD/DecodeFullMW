						<Anchor point="top" relativePoint="top" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentIcon" file="ui/mobile/texture0/battlepass.xml" uvname="icon_lv_bp1" abs_x="64" abs_y="64">
