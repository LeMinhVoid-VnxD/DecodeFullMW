	## NewBattlePass任务进度推送面板
	<Frame name="BPMissionPush" parent="UIClient" frameStrata="TOOLTIP" hidden="true" framelevel="1001" input_transparent="true">
		<Size>
			<AbsDimension x="227" y="36" />
		</Size>
		<Anchors>
			<Anchor point="top" relativePoint="top" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="18" />
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBkg" file="ui/mobile/texture0/battlepass.xml" uvname="img_blood_strip_boardbule" abs_x="227" abs_y="36" DrawType="ninesquare">
					<NineSquare ox="0" oy="0" tilew="10" tileh="10"/>
					<Anchors>
						<Anchor point="top" relativePoint="top" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>

				<Texture name="$parentProBarBg" file="ui/mobile/texture0/battlepass.xml" uvname="img_board_barbule" abs_x="231" abs_y="10" DrawType = "center">
					<Center>
						<Left offsetX="0" offsetY="0" w="5" h="10"/>
						<Center offsetX="5" offsetY="0" w="10" h="10" />
						<Right offsetX="15" offsetY="0" w="5" h="10" />
					</Center>
					<Anchors>
						<Anchor point="top" relativeTo="$parentBkg" relativePoint="top">
							<Offset>
								<AbsDimension x="0" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentProBar" file="ui/mobile/texture0/battlepass.xml" uvname="img_bar_bule" abs_x="120" abs_y="10">
					<Anchors>
						<Anchor point="left" relativeTo="$parentProBarBg" relativePoint="left">
							<Offset>
								<AbsDimension x="0" y="0" />
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>

				## 任务描述
				<FontString name="$parentTips" fonttype="BlackFont18" justifyH="left" abs_x="150" abs_y="18" text="qiwi距离任务解锁还有：">
					<Color r="215" g="215" b="215"/>
					<Anchors>
						<Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBkg">
							<Offset>
								<AbsDimension x="5" y="17" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentProDesc" fonttype="BlackFont12" justifyH="right" abs_x="60" abs_y="12" text="60/100">
					<Color r="215" g="215" b="215"/>
					<Anchors>
						<Anchor point="topright" relativePoint="topright" relativeTo="$parentBkg">
							<Offset>
								<AbsDimension x="-5" y="17" />
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
		</Frames>
		<Scripts>
			<OnUpdate>GetInst("UIManager"):GetCtrl("BPMissionPush"):OnUpdate();</OnUpdate>
		</Scripts>
	</Frame>
</Ui>