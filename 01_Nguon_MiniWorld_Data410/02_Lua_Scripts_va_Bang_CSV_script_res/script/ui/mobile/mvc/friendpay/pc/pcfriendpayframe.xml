<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Ui>
	<Script file="ui/mobile/mvc/friendPay/pc/PCFriendPayFrameModel.lua"/>
	<Script file="ui/mobile/mvc/friendPay/pc/PCFriendPayFrameView.lua"/>
	<Script file="ui/mobile/mvc/friendPay/pc/PCFriendPayFrameCtrl.lua"/>
  
	##二维码代付链接界面
	<Frame name="PCFriendPayFrame" parent="UIClient" frameStrata="HIGH" hidden="true" framelevel="2200" >
		<Size>
			<RelDimension x="1.0" y="1.0"/>
		</Size>
		<Anchors>
			<Anchor point="center" relativePoint="center" relativeTo="$parent">
				<Offset>
					<AbsDimension x="0" y="0"/>
				</Offset>
			</Anchor>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentChenDi" inherits="TemplateBkg1">
					<Size>
						<AbsDimension x="653" y="338" />
					</Size>
					<Anchors>
						<Anchor point="center" relativePoint="center" relativeTo="$parent">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
				<Texture name="$parentClipIcon" file="ui/mobile/texture2/messagebox.xml" uvname="popup_clip.png" abs_x="105" abs_y="100">
					<Anchors>
						<Anchor point="topleft" relativeTo="$parentChenDi" relativePoint="topleft">
							<Offset>
								<AbsDimension x="-19" y="-22" />
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>	
			</Layer>
		</Layers>
		<Frames>
			<RichText name="$parentDesc" lineInterval="6" multiLine="true" fonttype="BlackFont26" autoextend="true" >
				<Size>
					<AbsDimension x="376" y="29" />
				</Size>
				<Anchors>
					<Anchor point="topleft" relativeTo="$parentChenDi" relativePoint="topleft">
						<Offset>
							<AbsDimension x="65" y="85" />
						</Offset>
					</Anchor>
				</Anchors>
			</RichText>
			<RichText name="$parentDesc2" lineInterval="6" multiLine="true" fonttype="BlackFont26" autoextend="true" >
				<Size>
					<AbsDimension x="138" y="26" />
				</Size>
				<Anchors>
					<Anchor point="topleft" relativeTo="$parentChenDi" relativePoint="topleft">
						<Offset>
							<AbsDimension x="65" y="211" />
						</Offset>
					</Anchor>
				</Anchors>
			</RichText>
			##复制链接
			<Button name="$parentCopyUrlBtn" inherits="TemplateBtn3">
				<Anchors>
					<Anchor point="topleft" relativeTo="$parentChenDi" relativePoint="topleft">
						<Offset>
							<AbsDimension x="236" y="196"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Layers>
					<Layer level="overlay">
						<FontString name="$parentName" fonttype="BlackFont24" justifyH="center" text="$736">
							<Color r="55" g="54" b="51"/>
							<Size>
								<AbsDimension x="180" y="25"/>
							</Size>
							<Anchors>
								<Anchor point="center" relativePoint="center" relativeTo="$parent">
									<Offset>
										<AbsDimension x="0" y="0"/>
									</Offset>
								</Anchor>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Scripts>
						<OnClick>GetInst("UIManager"):GetCtrl("PCFriendPayFrame"):CopyUrlClick();</OnClick>
				</Scripts>	
			</Button>
			##关闭按钮
			<Button name="$parentCloseBtn" inherits="TemplateCloseBtn0">
				<Anchors>
					<Anchor point="topright" relativeTo="$parentChenDi" relativePoint="topright">
						<Offset>
							<AbsDimension x="-23" y="16"/>
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnClick>GetInst("UIManager"):GetCtrl("PCFriendPayFrame"):CloseBtnOnClicked();</OnClick>
				</Scripts>
			</Button>	
		</Frames>
	</Frame>
</Ui>